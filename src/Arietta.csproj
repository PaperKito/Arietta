<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>

		<Version>1.0.2</Version>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<OutputPath>bin\x64\Debug\</OutputPath>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<LangVersion>preview</LangVersion>
		<RootNamespace>Arietta</RootNamespace>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x64</Platforms>
		<Platform Condition=" '$(Platform)' == '' ">x64</Platform>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<RuntimeIdentifier Condition=" '$(RuntimeIdentifier)' == '' ">win-x64</RuntimeIdentifier>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>

		<NoWarn>$(NoWarn);MVVMTK0050</NoWarn>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.250402" />
		<PackageReference Include="Dapper" Version="2.1.35" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />

		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
		<PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />

	<PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" ExcludeAssets="all" />
	<PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" ExcludeAssets="all" />
	<PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.5.5" ExcludeAssets="all" />
	<PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="all" />

	<PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="all" />

	<PackageReference Include="System.Numerics.Tensors" Version="9.0.0" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
		<PackageReference Include="Vanara.PInvoke.User32" Version="5.0.5" />

		<PackageReference Include="Starward.GameInput" Version="0.3.1" />
		<PackageReference Include="Vanara.PInvoke.ComCtl32" Version="5.0.5" />
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="Assets\**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<UnusedWinAppSdkPayload Include="RestartAgent.exe" />
		<UnusedWinAppSdkPayload Include="Microsoft.UI.Designer.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.AppNotifications.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.AppNotifications.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.AppNotifications.Builder.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.AppNotifications.Builder.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.BadgeNotifications.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.BadgeNotifications.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.PushNotifications.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.PushNotifications.winmd" />
		<UnusedWinAppSdkPayload Include="PushNotificationsLongRunningTask.ProxyStub.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Storage.Pickers.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Storage.Pickers.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Storage.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Storage.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Media.Capture.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Media.Capture.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Security.Authentication.OAuth.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Security.Authentication.OAuth.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Management.Deployment.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Management.Deployment.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.System.Power.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.System.Power.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.System.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.System.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Foundation.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Foundation.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Security.AccessControl.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Security.AccessControl.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.ApplicationModel.Background.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.ApplicationModel.Background.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.ApplicationModel.WindowsAppRuntime.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.ApplicationModel.WindowsAppRuntime.winmd" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.Globalization.winmd" />

		<UnusedWinAppSdkPayload Include="Microsoft.WindowsAppRuntime.Bootstrap.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.WindowsAppRuntime.Bootstrap.Net.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.ApplicationModel.DynamicDependency.Projection.dll" />
		<UnusedWinAppSdkPayload Include="Microsoft.Windows.ApplicationModel.DynamicDependency.winmd" />
	</ItemGroup>

	<Target Name="TrimUnusedWinAppSdkPayload" AfterTargets="Build">
		<Delete Files="@(UnusedWinAppSdkPayload->'$(OutDir)%(Identity)')" />

		<ItemGroup>
			<_WinmdToDelete Include="$(OutDir)*.winmd" />
		</ItemGroup>
		<Delete Files="@(_WinmdToDelete)" />
	</Target>

	<Target Name="TrimUnusedWinAppSdkPayloadOnPublish" AfterTargets="Publish">
		<Delete Files="@(UnusedWinAppSdkPayload->'$(PublishDir)%(Identity)')" />
		<ItemGroup>
			<_WinmdToDeleteOnPublish Include="$(PublishDir)*.winmd" />
		</ItemGroup>
		<Delete Files="@(_WinmdToDeleteOnPublish)" />
	</Target>

</Project>

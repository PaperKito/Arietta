<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Arietta.Features.GachaLog.CloudGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:lang="using:Arietta.Localization"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="{ThemeResource CustomAcrylicBrush}" Padding="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="{x:Bind lang:Lang.Instance.CloudGame_Title, Mode=OneWay}" />
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.Instance.CloudGame_StatusDefault, Mode=OneWay}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="Button_Grab"
                    Grid.Column="1"
                    MinWidth="140"
                    Padding="16,8"
                    VerticalAlignment="Center"
                    Click="Grab_Click"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="GrabProgress"
                                  Width="16"
                                  Height="16"
                                  IsActive="False"
                                  Visibility="Collapsed" />
                    <FontIcon Margin="0,2,0,0" FontSize="14" Glyph="&#xE8B7;" />
                    <TextBlock Text="{x:Bind lang:Lang.Instance.CloudGame_Grab, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <WebView2 x:Name="Web" Grid.Row="1" />
    </Grid>

</Window>

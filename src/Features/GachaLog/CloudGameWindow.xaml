<?xml version="1.0" encoding="utf-8" ?>
<mf:WindowEx x:Class="Arietta.Features.GachaLog.CloudGameWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Padding="16,0,150,0"
              Background="Transparent"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0"
                      VerticalAlignment="Center"
                      FontSize="16"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Glyph="&#xE753;" />

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1">
                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="{x:Bind lang:Lang.Instance.CloudGame_WindowTitle, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           MaxLines="1"
                           Text="{x:Bind lang:Lang.Instance.CloudGame_StatusDefault, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button x:Name="Button_Grab"
                    Grid.Column="2"
                    MinWidth="140"
                    Padding="16,8"
                    VerticalAlignment="Center"
                    Click="Grab_Click"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="GrabProgress"
                                  Width="16"
                                  Height="16"
                                  IsActive="False"
                                  Visibility="Collapsed" />
                    <FontIcon Margin="0,2,0,0" FontSize="14" Glyph="&#xE8B7;" />
                    <TextBlock Text="{x:Bind lang:Lang.Instance.CloudGame_Grab, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <Border Grid.ColumnSpan="3"
                    Height="1"
                    Margin="-16,0,-150,0"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    IsHitTestVisible="False" />
        </Grid>

        <WebView2 x:Name="Web" Grid.Row="1" />
    </Grid>

</mf:WindowEx>

<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.GachaLog.GachaLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:local="using:Arietta.Features.GachaLog"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <mf:PageBase.Resources>
        <SolidColorBrush x:Key="GachaColumnDivider" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="GachaTextPrimary" Color="#F2F2F2" />
        <SolidColorBrush x:Key="GachaTextSecondary" Color="#A6A6A6" />

        <SolidColorBrush x:Key="GachaStar5" Color="#FFA500" />
        <SolidColorBrush x:Key="GachaStar4" Color="#C864E0" />
        <SolidColorBrush x:Key="GachaStar3" Color="#5EAAED" />
        <SolidColorBrush x:Key="GachaStar5Avg" Color="#3BA272" />

        <DataTemplate x:Key="BarItemTemplate" x:DataType="local:BarItemViewModel">
            <Grid Height="30" ToolTipService.ToolTip="{Binding Time}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MinWidth="28" />
                </Grid.ColumnDefinitions>

                <Border Width="28"
                        Height="28"
                        Margin="0,0,4,0"
                        CornerRadius="4"
                        Visibility="{x:Bind IconVisibility, Mode=OneWay}">
                    <Border.Background>
                        <ImageBrush AlignmentY="Top"
                                    ImageSource="{x:Bind Icon, Mode=OneWay}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border Grid.Column="1"
                        Height="22"
                        Margin="-4,0,-4,0"
                        VerticalAlignment="Center"
                        Background="{x:Bind BarBrush}"
                        CornerRadius="2" />
                <TextBlock x:Name="NameText"
                           Grid.Column="1"
                           Margin="2,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource GachaTextPrimary}"
                           Text="{x:Bind Name}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Margin="8,0,4,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="{StaticResource GachaStar5}"
                           Text="up!"
                           Visibility="{x:Bind UpVisibility}" />
                <TextBlock x:Name="PityText"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource GachaTextPrimary}"
                           Text="{x:Bind Pity}"
                           TextAlignment="Right" />
            </Grid>
        </DataTemplate>
    </mf:PageBase.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="32,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontSize="20"
                   FontWeight="Bold"
                   Text="{x:Bind lang:Lang.Instance.GachaLogPage_ConveneRecords, Mode=OneWay}" />

        <StackPanel Margin="0,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
            <ComboBox MinWidth="140"
                      VerticalAlignment="Center"
                      ItemsSource="{x:Bind ViewModel.Players}"
                      PlaceholderText="{x:Bind lang:Lang.Instance.GachaLogPage_SelectPlayer, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedPlayer, Mode=TwoWay}" />

            <SplitButton Height="32"
                         Command="{x:Bind ViewModel.RefreshCommand}"
                         CommandParameter="all"
                         IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolReversedConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing Width="16"
                                  Height="16"
                                  IsActive="{x:Bind ViewModel.IsLoading}"
                                  Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <FontIcon Margin="0,2,0,0" FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock Text="{x:Bind lang:Lang.Instance.GachaLogPage_Refresh, Mode=OneWay}" />
                </StackPanel>
                <SplitButton.Flyout>
                    <MenuFlyout>

                        <MenuFlyoutItem Command="{x:Bind ViewModel.RefreshCommand}"
                                        CommandParameter="cache"
                                        Text="{x:Bind lang:Lang.Instance.GachaLogPage_UpdateSavedUrl, Mode=OneWay}" />

                        <MenuFlyoutItem Command="{x:Bind ViewModel.RefreshCommand}"
                                        CommandParameter="all"
                                        Text="{x:Bind lang:Lang.Instance.GachaLogPage_UpdateAll, Mode=OneWay}" />

                        <MenuFlyoutItem Click="ImportUrl_Click" Text="{x:Bind lang:Lang.Instance.GachaLogPage_InputUrl, Mode=OneWay}" />

                        <MenuFlyoutItem Click="CloudGame_Click" Text="{x:Bind lang:Lang.Instance.GachaLogPage_ViaCloudGame, Mode=OneWay}" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>

            <Button Height="32" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Margin="0,2,0,0" FontSize="14" Glyph="&#xE713;" />
                    <TextBlock Text="{x:Bind lang:Lang.Instance.SettingPage_AppSettings, Mode=OneWay}" />
                </StackPanel>
                <Button.Flyout>

                    <Flyout>
                        <StackPanel MinWidth="200"
                                    Spacing="8">
                            <TextBlock FontSize="16"
                                       Text="{x:Bind lang:Lang.Instance.GachaLogPage_OtherSettings, Mode=OneWay}" />

                            <Button Margin="0,8,0,0" Command="{x:Bind ViewModel.CopyUrlCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                                    <TextBlock Text="{x:Bind lang:Lang.Instance.GachaLogPage_CopyUrl, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.Instance.GachaLogPage_LinkHelp, Mode=OneWay}" />
                            <TextBlock Margin="0,-4,0,0"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.Instance.GachaLogPage_LinkHelpDesc, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Stretch"
                                    Click="ClearSavedUrl_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xEA99;" />
                                    <TextBlock Text="{x:Bind lang:Lang.Instance.GachaLogPage_ClearSavedUrl, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <Button HorizontalAlignment="Stretch"
                                    Margin="0,4,0,0"
                                    Content="{x:Bind lang:Lang.Instance.GachaLogPage_Language, Mode=OneWay}">
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <StackPanel MinWidth="200">

                                            <ComboBox x:Name="ComboBox_GachaLanguage"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="ComboBox_GachaLanguage_SelectionChanged">
                                                <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GachaLangOption_ZhHans, Mode=OneWay}" />
                                                <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GachaLangOption_ZhHant, Mode=OneWay}" />
                                                <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GachaLangOption_En, Mode=OneWay}" />
                                                <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GachaLangOption_Ja, Mode=OneWay}" />
                                                <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GachaLangOption_Ko, Mode=OneWay}" />
                                                <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GachaLangOption_Fr, Mode=OneWay}" />
                                                <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GachaLangOption_De, Mode=OneWay}" />
                                                <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GachaLangOption_Es, Mode=OneWay}" />
                                                <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GachaLangOption_Th, Mode=OneWay}" />
                                                <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GachaLangOption_PtBr, Mode=OneWay}" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <MenuFlyoutSeparator />

                            <Button HorizontalAlignment="Stretch" Content="{x:Bind lang:Lang.Instance.GachaLogPage_ImportExport, Mode=OneWay}">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel MinWidth="200" Spacing="8">
                                            <Button HorizontalAlignment="Stretch" Content="{x:Bind lang:Lang.Instance.GachaLogPage_ExportAs, Mode=OneWay}">
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="Left">
                                                        <MenuFlyoutItem Click="ExportUgf_Click" Text="{x:Bind lang:Lang.Instance.GachaLogPage_ExportFormatUgf, Mode=OneWay}" />
                                                        <MenuFlyoutItem Click="ExportExcel_Click" Text="{x:Bind lang:Lang.Instance.GachaLogPage_ExportFormatExcel, Mode=OneWay}" />
                                                        <MenuFlyoutItem Click="ExportCsv_Click" Text="{x:Bind lang:Lang.Instance.GachaLogPage_ExportFormatCsv, Mode=OneWay}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>

                                            <Button x:Name="Button_Import"
                                                    HorizontalAlignment="Stretch"
                                                    Click="ImportRecords_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Margin="0,2,0,0"
                                                              FontSize="16"
                                                              Glyph="&#xE896;" />
                                                    <TextBlock Text="{x:Bind lang:Lang.Instance.GachaLogPage_ImportRecords, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button HorizontalAlignment="Stretch" Content="{x:Bind lang:Lang.Instance.GachaLogPage_HidePools, Mode=OneWay}">
                                <Button.Flyout>
                                    <Flyout>
                                        <ListView x:Name="ListView_GachaPools"
                                                  MinWidth="200"
                                                  SelectionMode="Multiple"
                                                  SelectionChanged="ListView_GachaPools_SelectionChanged">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:GachaPoolItem">
                                                    <TextBlock Text="{x:Bind Name}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button HorizontalAlignment="Stretch" Click="DeletePlayer_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                              Glyph="&#xE74D;" />
                                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind lang:Lang.Instance.GachaLogPage_DeletePlayer, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Height="32"
                    BorderThickness="0"
                    Click="ToggleItemStatsPane_Click"
                    CornerRadius="14,0,0,14"
                    IsEnabled="{x:Bind ViewModel.HasItemStats, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind lang:Lang.Instance.GachaLogPage_ItemStats, Mode=OneWay}">
                <FontIcon Margin="6,2,4,0"
                          FontSize="18"
                          Glyph="&#xE8A0;"
                          IsTextScaleFactorEnabled="False" />
            </Button>
        </StackPanel>

        <SplitView Name="SplitView_Content"
                   Grid.Row="1"
                   BorderThickness="0"
                   CornerRadius="12,0,0,12"
                   DisplayMode="Overlay"
                   IsPaneOpen="{x:Bind ViewModel.IsPaneOpen, Mode=TwoWay}"
                   OpenPaneLength="508"
                   PaneBackground="{ThemeResource CustomOverlayAcrylicBrush}"
                   PanePlacement="Right">

            <SplitView.Content>
                <Grid>

                    <ScrollViewer x:Name="ScrollViewer_Columns"
                                  HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Auto"
                                  Visibility="{x:Bind ContentVisibility(ViewModel.HasData), Mode=OneWay}">
                        <ItemsControl Margin="24,8,24,16" ItemsSource="{x:Bind ViewModel.Pools}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:PoolViewModel">

                                    <Border Width="268"
                                            Padding="12,10"
                                            Shadow="{ThemeResource ThemeShadow}"
                                            Translation="0,0,16"
                                            Background="{ThemeResource CustomOverlayAcrylicBrush}"
                                            BorderBrush="{StaticResource GachaColumnDivider}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            RequestedTheme="Dark">
                                        <StackPanel>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource GachaTextPrimary}"
                                                           Text="{x:Bind Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           FontSize="16"
                                                           Foreground="{StaticResource GachaTextPrimary}"
                                                           Text="{x:Bind Total}" />
                                            </Grid>
                                            <TextBlock MinHeight="14"
                                                       FontSize="12"
                                                       Foreground="{StaticResource GachaTextSecondary}"
                                                       Text="{x:Bind Range}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <Border Height="1"
                                                    Margin="0,6,0,4"
                                                    Background="{StaticResource GachaColumnDivider}" />

                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GachaStar5Avg}"
                                                               Text="5★" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{StaticResource GachaStar5Avg}"
                                                               Text="{x:Bind lang:Lang.Instance.GachaLogPage_Avg5, Mode=OneWay}" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{StaticResource GachaStar5Avg}"
                                                               Text="{x:Bind lang:Lang.Instance.GachaLogPage_Up, Mode=OneWay}"
                                                               Visibility="{x:Bind HasUp, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal"
                                                            Spacing="2">
                                                    <TextBlock FontSize="12" Foreground="{StaticResource GachaStar5Avg}" Text="{x:Bind Avg5Text}" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{StaticResource GachaStar5Avg}"
                                                               Text=" / "
                                                               Visibility="{x:Bind HasUp, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{StaticResource GachaStar5Avg}"
                                                               Text="{x:Bind UpText}"
                                                               Visibility="{x:Bind HasUp, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GachaStar5}"
                                                               Text="5★" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{StaticResource GachaStar5}"
                                                               Text="{x:Bind lang:Lang.Instance.GachaLogPage_Stat, Mode=OneWay}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           FontSize="12"
                                                           Foreground="{StaticResource GachaStar5}"
                                                           Text="{x:Bind Count5Text}" />
                                            </Grid>

                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GachaStar4}"
                                                               Text="4★" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{StaticResource GachaStar4}"
                                                               Text="{x:Bind lang:Lang.Instance.GachaLogPage_Stat, Mode=OneWay}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           FontSize="12"
                                                           Foreground="{StaticResource GachaStar4}"
                                                           Text="{x:Bind Count4Text}" />
                                            </Grid>

                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GachaStar3}"
                                                               Text="3★" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{StaticResource GachaStar3}"
                                                               Text="{x:Bind lang:Lang.Instance.GachaLogPage_Stat, Mode=OneWay}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           FontSize="12"
                                                           Foreground="{StaticResource GachaStar3}"
                                                           Text="{x:Bind Count3Text}" />
                                            </Grid>

                                            <cwc:Segmented Margin="0,10,0,6"
                                                           HorizontalAlignment="Stretch"
                                                           SelectedIndex="{x:Bind SelectedRarityIndex, Mode=TwoWay}">
                                                <cwc:SegmentedItem>
                                                    <TextBlock FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GachaStar5}"
                                                               IsTextScaleFactorEnabled="False"
                                                               Text="5★" />
                                                </cwc:SegmentedItem>
                                                <cwc:SegmentedItem>
                                                    <TextBlock FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GachaStar4}"
                                                               IsTextScaleFactorEnabled="False"
                                                               Text="4★" />
                                                </cwc:SegmentedItem>
                                            </cwc:Segmented>

                                            <ItemsControl Margin="0,2,0,0"
                                                          ItemTemplate="{StaticResource BarItemTemplate}"
                                                          ItemsSource="{x:Bind Items5}"
                                                          Visibility="{x:Bind Is5Selected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ItemsControl Margin="0,2,0,0"
                                                          ItemTemplate="{StaticResource BarItemTemplate}"
                                                          ItemsSource="{x:Bind Items4}"
                                                          Visibility="{x:Bind Is4Selected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind EmptyVisibility(ViewModel.HasData, ViewModel.IsLoading), Mode=OneWay}">
                        <FontIcon HorizontalAlignment="Center"
                                  FontSize="40"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Glyph="&#xF4A5;" />
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Text="{x:Bind lang:Lang.Instance.GachaLogPage_EmptyTitle, Mode=OneWay}" />
                        <TextBlock MaxWidth="420"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   LineHeight="20"
                                   Text="{x:Bind lang:Lang.Instance.GachaLogPage_EmptyDesc, Mode=OneWay}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </SplitView.Content>

            <SplitView.Pane>
                <GridView Padding="24,12,24,12"
                          ItemsSource="{x:Bind ViewModel.ItemStats}"
                          SelectionMode="None">
                    <GridView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:GachaItemStat">

                            <StackPanel Width="80"
                                        Margin="4,2,4,2"
                                        Spacing="3">
                                <Grid Height="80" CornerRadius="8">
                                    <Border CornerRadius="8"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Visibility="{x:Bind IconVisibility, Mode=OneWay}">
                                        <Border.Background>
                                            <ImageBrush AlignmentY="Top"
                                                        ImageSource="{x:Bind Icon, Mode=OneWay}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>

                                    <TextBlock Margin="4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind Name}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind NameVisibility, Mode=OneWay}" />

                                    <Border Height="3"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="0,0,8,8"
                                            Background="{x:Bind QualityBrush}" />
                                </Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextScaleFactorEnabled="False"
                                           Text="{x:Bind CountText}" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </SplitView.Pane>

        </SplitView>
    </Grid>

</mf:PageBase>

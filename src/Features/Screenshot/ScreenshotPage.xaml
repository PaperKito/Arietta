<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.Screenshot.ScreenshotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:local="using:Arietta.Features.Screenshot"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             xmlns:mxi="using:Microsoft.Xaml.Interactivity"
             xmlns:mxc="using:Microsoft.Xaml.Interactivity"
             xmlns:xim="using:Microsoft.Xaml.Interactivity"
             x:DefaultBindMode="OneTime"
             mc:Ignorable="d">

    <mf:PageBase.Resources>
        <CircleEase x:Key="CircleEase" />
    </mf:PageBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Panel_Empty"
                    Grid.Row="1"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
            <FontIcon FontSize="32"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Glyph="&#xE91B;"
                      IsTextScaleFactorEnabled="False" />
            <TextBlock HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.Instance.ScreenshotPage_Empty, Mode=OneWay}" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind lang:Lang.Instance.ScreenshotPage_EmptyDesc, Mode=OneWay}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <GridView x:Name="GridView_Images"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Padding="24,0,12,12"
                  IsItemClickEnabled="True"
                  ItemClick="GridView_Images_ItemClick"
                  SelectionChanged="GridView_Images_SelectionChanged"
                  SelectionMode="None">
            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="GridViewHeaderItem">
                            <Setter Property="Template">
                                <Setter.Value>

                                    <ControlTemplate TargetType="ContentControl">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:ScreenshotGroup">
                            <TextBlock FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       Text="{x:Bind Header}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="CornerRadius" Value="4" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid AreStickyGroupHeadersEnabled="True"
                                   ItemHeight="128"
                                   ItemWidth="218"
                                   Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:ScreenshotItem">
                    <Grid Width="206"
                          Height="116"
                          CornerRadius="4">
                        <Grid.Resources>

                            <Storyboard x:Key="GridZoomInStoryboard">
                                <DoubleAnimation EasingFunction="{StaticResource CircleEase}"
                                                 Storyboard.TargetName="Image_Thumb"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.15"
                                                 Duration="0:0:0.3" />
                                <DoubleAnimation EasingFunction="{StaticResource CircleEase}"
                                                 Storyboard.TargetName="Image_Thumb"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.15"
                                                 Duration="0:0:0.3" />
                            </Storyboard>
                            <Storyboard x:Key="GridZoomOutStoryboard">
                                <DoubleAnimation EasingFunction="{StaticResource CircleEase}"
                                                 Storyboard.TargetName="Image_Thumb"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.6" />
                                <DoubleAnimation EasingFunction="{StaticResource CircleEase}"
                                                 Storyboard.TargetName="Image_Thumb"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1"
                                                 Duration="0:0:0.6" />
                            </Storyboard>
                        </Grid.Resources>
                        <mxi:Interaction.Behaviors>
                            <mxc:EventTriggerBehavior EventName="PointerEntered">
                                <xim:ControlStoryboardAction Storyboard="{StaticResource GridZoomInStoryboard}" />
                            </mxc:EventTriggerBehavior>
                            <mxc:EventTriggerBehavior EventName="PointerExited">
                                <xim:ControlStoryboardAction Storyboard="{StaticResource GridZoomOutStoryboard}" />
                            </mxc:EventTriggerBehavior>
                        </mxi:Interaction.Behaviors>
                        <Image Name="Image_Thumb"
                               Width="206"
                               Height="116"
                               RenderTransformOrigin="0.5,0.5"
                               Source="{x:Bind Thumbnail}"
                               Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel Grid.Row="0"
                    Margin="0,0,28,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
            <TextBlock x:Name="TextBlock_SelectCount"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextScaleFactorEnabled="False" />
            <ToggleButton x:Name="ToggleButton_MultiSelect"
                          Checked="ToggleButton_MultiSelect_Changed"
                          Content="{x:Bind lang:Lang.Instance.ScreenshotPage_MultiSelect, Mode=OneWay}"
                          IsTextScaleFactorEnabled="False"
                          Unchecked="ToggleButton_MultiSelect_Changed" />

            <Button x:Name="Button_DeleteSelected"
                    Click="Button_DeleteSelected_Click"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                              Glyph="&#xE74D;"
                              IsTextScaleFactorEnabled="False" />
                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               IsTextScaleFactorEnabled="False"
                               Text="{x:Bind lang:Lang.Instance.ScreenshotPage_Delete, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button x:Name="Button_OpenFolder"
                    Click="Button_OpenFolder_Click"
                    Content="{x:Bind lang:Lang.Instance.ScreenshotPage_OpenFolder, Mode=OneWay}"
                    IsTextScaleFactorEnabled="False" />
        </StackPanel>

    </Grid>

</mf:PageBase>

<?xml version="1.0" encoding="utf-8" ?>
<mf:WindowEx x:Class="Arietta.Features.ViewHost.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Arietta.Features.ViewHost"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             xmlns:mh="using:Arietta.Helpers"
             xmlns:mxi="using:Microsoft.Xaml.Interactivity"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <local:MainView x:Name="MainContentHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <StackPanel Width="600"
                    Margin="0,0,0,100"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Spacing="8">
            <mxi:Interaction.Behaviors>
                <mh:InAppToast Tag="MainWindow" />
            </mxi:Interaction.Behaviors>
        </StackPanel>

    </Grid>

</mf:WindowEx>

<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Arietta.Features.ViewHost.CloseWindowDialog"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:lang="using:Arietta.Localization"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              x:DefaultBindMode="OneWay"
              Style="{ThemeResource DefaultContentDialogStyle}"
              Background="{ThemeResource CustomDialogAcrylicBrush}"
              BorderThickness="0"
              CornerRadius="8"
              Title="{x:Bind lang:Lang.Instance.CloseDialog_Title}"
              PrimaryButtonText="{x:Bind lang:Lang.Instance.Common_Confirm}"
              CloseButtonText="{x:Bind lang:Lang.Instance.Common_Cancel}"
              DefaultButton="Primary"
              mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">440</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">340</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="4">
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind lang:Lang.Instance.CloseDialog_Content}"
                   TextWrapping="Wrap" />
        <RadioButtons x:Name="RadioGroup"
                      SelectedIndex="0">
            <RadioButton Content="{x:Bind lang:Lang.Instance.ExperienceSettingPage_MinimizeToSystemTray}" />
            <RadioButton Content="{x:Bind lang:Lang.Instance.SettingPage_ExitApp}" />
        </RadioButtons>
    </StackPanel>

</ContentDialog>

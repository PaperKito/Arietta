<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Arietta.Features.ViewHost.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdb="using:Arietta.Features.DynamicBackground"
             xmlns:gs="using:Arietta.Features.GameSelector"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid Background="Transparent">

        
        <Image Name="Image_Background"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

        
        <mdb:DynamicBackgroundHost x:Name="DynamicBgHost" />

        <Border Width="56"
                HorizontalAlignment="Left"
                Background="{ThemeResource CustomAcrylicBrush}" />

        <Border Name="Border_OverlayMask"
                Background="{ThemeResource CustomAcrylicBrush}"
                Opacity="0">
            <Border.OpacityTransition>
                <ScalarTransition />
            </Border.OpacityTransition>
        </Border>

        <NavigationView Name="MainView_NavigationView"
                        CompactPaneLength="56"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        ItemInvoked="NavigationView_ItemInvoked"
                        PaneDisplayMode="LeftCompact">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            </NavigationView.Resources>

            <NavigationView.PaneCustomContent>
                <Border Height="52" />
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItemSeparator />
                
                <NavigationViewItem Name="NavigationViewItem_Launcher"
                                    IsSelected="True"
                                    Tag="LauncherPage"
                                    ToolTipService.ToolTip="{x:Bind lang:Lang.Instance.MainPage_Launcer, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.MainPage_Launcer, Mode=OneWay}" />
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                
                <NavigationViewItem Name="NavigationViewItem_GameSetting"
                                    Tag="GameSettingPage"
                                    ToolTipService.ToolTip="{x:Bind lang:Lang.Instance.LauncherPage_GameSetting, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.LauncherPage_GameSetting, Mode=OneWay}" />
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                
                <NavigationViewItem Name="NavigationViewItem_Screenshot"
                                    Tag="ScreenshotPage"
                                    ToolTipService.ToolTip="{x:Bind lang:Lang.Instance.MainPage_GameScreenshot, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE91B;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.MainPage_GameScreenshot, Mode=OneWay}" />
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                
                <NavigationViewItem Name="NavigationViewItem_GachaLog" Tag="GachaLogPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF4A5;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.GachaLogPage_ConveneRecords, Mode=OneWay}" />
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                
                <NavigationViewItem Name="NavigationViewItem_KuroBbs"
                                    Tag="KuroBbsPage"
                                    ToolTipService.ToolTip="{x:Bind lang:Lang.Instance.KuroBbs, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF133;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.KuroBbs, Mode=OneWay}" />
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame Name="MainView_Frame" Margin="0,48,0,0" />

        </NavigationView>

        
        <gs:GameSelector x:Name="GameSelectorControl"
                         CurrentGameChanged="GameSelector_CurrentGameChanged" />

    </Grid>

</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.ViewHost.AdbToolPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left" Padding="0,0,24,24">

            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Click="Button_Back_Click"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{x:Bind lang:Lang.Instance.Toolbox, Mode=OneWay}" />
                    </ToolTipService.ToolTip>
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <TextBlock VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Text="{x:Bind lang:Lang.Instance.KuroAccount_UsbTitle, Mode=OneWay}" />
                <Button x:Name="Button_Help"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Spacing="10">
                                <TextBlock MaxWidth="380"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextScaleFactorEnabled="False"
                                           LineHeight="18"
                                           TextWrapping="Wrap">
                                    <Run Text="{x:Bind lang:Lang.Instance.KuroAccount_UsbDesc, Mode=OneWay}" />
                                    <Hyperlink NavigateUri="https://developer.android.com/tools/releases/platform-tools">
                                        <Run Text="Android Platform-Tools" />
                                    </Hyperlink>
                                    <Run Text="{x:Bind lang:Lang.Instance.KuroAccount_UsbDescTail, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock MaxWidth="380"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextScaleFactorEnabled="False"
                                           LineHeight="18"
                                           Text="{x:Bind lang:Lang.Instance.KuroAccount_UsbVerWarn, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <FontIcon FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Glyph="&#xE946;" />
                </Button>
            </StackPanel>

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TextBox_AdbPath"
                             Width="420"
                             PlaceholderText="{x:Bind lang:Lang.Instance.KuroAccount_AdbPlaceholder, Mode=OneWay}" />
                    <Button Click="Button_ApplyAdbPath_Click" Content="{x:Bind lang:Lang.Instance.KuroAccount_ApplyAdb, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="ComboBox_Devices"
                              Width="320"
                              PlaceholderText="{x:Bind lang:Lang.Instance.KuroAccount_SelectDevice, Mode=OneWay}" />
                    <Button Click="Button_RefreshDevices_Click" Content="{x:Bind lang:Lang.Instance.KuroAccount_RefreshDevices, Mode=OneWay}" />
                    <Button x:Name="Button_Capture"
                            Click="Button_Capture_Click"
                            Content="{x:Bind lang:Lang.Instance.KuroAccount_StartCapture, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock FontSize="18"
                           FontWeight="Bold"
                           Text="{x:Bind lang:Lang.Instance.KuroAccount_FieldsTitle, Mode=OneWay}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Width="70" VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.KuroAccount_Token, Mode=OneWay}" />
                    <TextBox x:Name="TextBox_Token"
                             Width="520"
                             PlaceholderText="{x:Bind lang:Lang.Instance.KuroAccount_FillHint, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Width="70" VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.KuroAccount_Did, Mode=OneWay}" />
                    <TextBox x:Name="TextBox_Did"
                             Width="520"
                             PlaceholderText="{x:Bind lang:Lang.Instance.KuroAccount_FillHint, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="Button_Save_Click"
                            Content="{x:Bind lang:Lang.Instance.KuroAccount_Save, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}" />
                    <Button Click="Button_Clear_Click" Content="{x:Bind lang:Lang.Instance.KuroAccount_Clear, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <Expander Header="{x:Bind lang:Lang.Instance.KuroAccount_Log, Mode=OneWay}" HorizontalAlignment="Stretch" IsExpanded="False">
                <TextBox x:Name="TextBox_Log"
                         MinHeight="160"
                         MaxHeight="280"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Expander>

        </StackPanel>
    </ScrollViewer>

</mf:PageBase>

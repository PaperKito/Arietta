<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.GamePacks.GamePackSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:local="using:Arietta.Features.GamePacks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="PackPillButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0,16,0" />
            <Setter Property="CornerRadius" Value="8,20,20,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel MaxWidth="1000"
                    Padding="0,0,0,24"
                    HorizontalAlignment="Stretch"
                    Spacing="18">

            <StackPanel Spacing="8">
                <TextBlock FontSize="18" FontWeight="Bold" Text="{x:Bind lang:Lang.Instance.GamePackPage_Title, Mode=OneWay}" />
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind lang:Lang.Instance.GamePackPage_Desc, Mode=OneWay}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="8">
                <Button Click="Rescan_Click" Style="{StaticResource PackPillButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        <TextBlock Text="{x:Bind lang:Lang.Instance.GamePackPage_Rescan, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Height="40"
                        Padding="20,0,18,1"
                        VerticalAlignment="Center"
                        Click="OpenFolder_Click"
                        CornerRadius="20"
                        ToolTipService.ToolTip="{x:Bind RootText}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock MaxWidth="520"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind RootText}"
                                   TextTrimming="CharacterEllipsis" />
                        <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE8A7;" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind lang:Lang.Instance.GamePackPage_Empty, Mode=OneWay}"
                       Visibility="{x:Bind EmptyVisibility, Mode=OneWay}" />

            <ListView HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind Rows, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PackRow">
                        <Border Padding="14,12,14,12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="48"
                                        Height="48"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        CornerRadius="8">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Text="{x:Bind Initial}"
                                                   Visibility="{x:Bind IconVisibility}" />
                                        <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   IsTextScaleFactorEnabled="False"
                                                   Text="{x:Bind Version}" />
                                    </StackPanel>
                                    <TextBlock FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextScaleFactorEnabled="False"
                                               Text="{x:Bind Author}" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2"
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              IsOn="{x:Bind IsEnabled}"
                                              OffContent=""
                                              OnContent=""
                                              Toggled="Enabled_Toggled"
                                              Tag="{x:Bind Pack}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>

</mf:PageBase>

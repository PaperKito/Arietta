<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Arietta.Features.GameLauncher.GameLauncherSettingDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Arietta.Localization"
               xmlns:local="using:Arietta.Features.GameLauncher"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomDialogAcrylicBrush}"
               BorderThickness="0"
               CornerRadius="8"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush" />
    </ContentDialog.Resources>

    <Grid Width="800"
          Height="480"
          Padding="24,24,24,0">

        <NavigationView IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        ItemInvoked="NavigationView_ItemInvoked"
                        OpenPaneLength="200"
                        PaneDisplayMode="Left">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewHeaderMargin">0</Thickness>
                <x:Double x:Key="PaneToggleButtonHeight">0</x:Double>
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <TextBlock Margin="16,0,0,8"
                           FontSize="20"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.Instance.LauncherPage_GameSetting, Mode=OneWay}" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_BasicInformation, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsSelected="True"
                                    Tag="0" />
                <NavigationViewItem Content="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_StartupArguments, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Tag="1" />
                <NavigationViewItem Content="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_CustomBackground, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Tag="2" />
            </NavigationView.MenuItems>

            <FlipView x:Name="FlipView_Settings"
                      Margin="24,24,0,0"
                      Background="Transparent"
                      Loaded="FlipView_Settings_Loaded">
                <FlipView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </FlipView.ItemsPanel>

                <FlipViewItem>
                    <StackPanel Spacing="12">

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="40"
                                  Height="40"
                                  CornerRadius="8">
<local:CachedImage Width="40"
                                                Height="40"
                                                Source="{x:Bind CurrentGameBizIcon.GameIcon, FallbackValue={x:Null}}" />
                                        <local:CachedImage Width="20"
                                                Height="20"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Source="{x:Bind CurrentGameBizIcon.ServerIcon, FallbackValue={x:Null}}" />
                                        <TextBlock Margin="0,1,0,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="Black"
                                                   IsTextScaleFactorEnabled="False"
                                                   Text="{x:Bind CurrentGameBizIcon.ServerCode}" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   IsTextScaleFactorEnabled="False"
                                                   Text="{x:Bind CurrentGameBizIcon.ServerCode}" />
                            </Grid>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Text="{x:Bind CurrentGameBizIcon.GameName}" />
                            <Button Grid.Column="2"
                                    Height="36"
                                    Command="{x:Bind LocateGameCommand}"
                                    CornerRadius="8"
                                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                    Visibility="{x:Bind InstallPath, Converter={StaticResource ObjectToVisibilityReversedConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Width="20"
                                              Height="20"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE838;" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind lang:Lang.Instance.InstallGameDialog_LocateGame, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Height="36"
                                    Command="{x:Bind ShowUninstallGameWarningCommand}"
                                    CornerRadius="8"
                                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                    Visibility="{x:Bind UninstallAndRepairEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Width="20"
                                              Height="20"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE74D;" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind lang:Lang.Instance.LauncherPage_UninstallGame, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid x:Name="Grid_UninstallWarning"
                              ColumnSpacing="12"
                              RowSpacing="8"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                       Text="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_UninstallGameWarning, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="1" Command="{x:Bind UninstallGameCommand}">
                                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_ConfirmUninstall, Mode=OneWay}" />
                            </Button>

                            <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        Visibility="{x:Bind UninstallScreenshotVisibility}">
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Text="{x:Bind UninstallScreenshotHint}"
                                           TextWrapping="Wrap" />
                                <Button Command="{x:Bind BackupAndUninstallCommand}">
                                    <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_BackupAndUninstall, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Text="{x:Bind UninstallError}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind UninstallError, Converter={StaticResource ObjectToVisibilityConverter}}" />

                        <Grid Height="40"
                              CornerRadius="8"
                              Visibility="{x:Bind InstallPath, Converter={StaticResource ObjectToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Height="40"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    BorderThickness="0"
                                    Command="{x:Bind OpenInstalGameFolderCommand}"
                                    CornerRadius="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="16,0,16,1"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               MaxLines="2"
                                               Text="{x:Bind InstallPath}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                    <FontIcon Grid.Column="1"
                                              Margin="16,0,16,0"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE8A7;" />
                                </Grid>
                            </Button>
                            <Button Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    BorderThickness="0"
                                    Command="{x:Bind DeleteGameInstllPathCommand}"
                                    CornerRadius="0">
                                <FontIcon FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Glyph="&#xE711;" />
                            </Button>
                        </Grid>

                        <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Text="{x:Bind LocateError}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind LocateErrorVisibility, Mode=OneWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Height="36"
                                    CornerRadius="8"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsEnabled="False"
                                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                    Visibility="{x:Bind GameSize, Converter={StaticResource ObjectToVisibilityConverter}}">
                                <TextBlock>
                                    <Run Text="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_Size, Mode=OneWay}" />
                                    <Run Text="{x:Bind GameSize}" />
                                </TextBlock>
                            </Button>
                            <Button Height="36"
                                    Command="{x:Bind LocateGameCommand}"
                                    CornerRadius="8"
                                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                    Visibility="{x:Bind InstallPath, Converter={StaticResource ObjectToVisibilityConverter}}">
                                <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_RelocateGame, Mode=OneWay}" />
                            </Button>
                            <Button x:Name="Button_RepairGame"
                                    Height="36"
                                    Command="{x:Bind RepairGameCommand}"
                                    CornerRadius="8"
                                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                    Visibility="{x:Bind UninstallAndRepairEnabled}">
                                <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind lang:Lang.Instance.LauncherPage_RepairGame, Mode=OneWay}" />
                            </Button>
                            <Button x:Name="Button_StartRepairing"
                                    Height="36"
                                    Command="{x:Bind StartRepairCommand}"
                                    CornerRadius="8"
                                    Content="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_StartRepairing, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="Collapsed" />
                        </StackPanel>

                        <Grid x:Name="Panel_RepairProgress"
                              ColumnSpacing="12"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <ProgressBar x:Name="ProgressBar_Repair"
                                             IsIndeterminate="True" />
                                <TextBlock x:Name="Text_RepairStatus"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="Button_RepairCancel_Click"
                                    Content="{x:Bind lang:Lang.Instance.Common_Cancel, Mode=OneWay}"
                                    CornerRadius="8"
                                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}" />
                        </Grid>

                        <TextBlock x:Name="TextBlock_RepairError"
                                   FontSize="12"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <ToggleSwitch IsOn="{x:Bind EnableBannerAndPost, Mode=TwoWay}"
                                      OffContent="{x:Bind lang:Lang.Instance.LauncherPage_ShowGameAnnouncement, Mode=OneWay}"
                                      OnContent="{x:Bind lang:Lang.Instance.LauncherPage_ShowGameAnnouncement, Mode=OneWay}" />

                    </StackPanel>
                </FlipViewItem>

                <FlipViewItem>
                    <StackPanel Spacing="12">

                        <TextBlock Text="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_CommandLineArgument, Mode=OneWay}" />

                        <TextBox MinWidth="320"
                                 HorizontalAlignment="Left"
                                 IsSpellCheckEnabled="False"
                                 Text="{x:Bind StartGameArgument, Mode=TwoWay}"
                                 TextWrapping="Wrap" />

                        <ToggleSwitch Margin="0,12,0,-4"
                                      IsOn="{x:Bind EnableThirdPartyTool, Mode=TwoWay}"
                                      OffContent="{x:Bind lang:Lang.Instance.LauncherPage_CustomStartExecutable, Mode=OneWay}"
                                      OnContent="{x:Bind lang:Lang.Instance.LauncherPage_CustomStartExecutable, Mode=OneWay}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Height="36"
                                    BorderThickness="0"
                                    Command="{x:Bind ChangeThirdPartyPathCommand}"
                                    CornerRadius="8"
                                    IsEnabled="{x:Bind EnableThirdPartyTool}"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7FC;" />
                                    <TextBlock Text="{x:Bind lang:Lang.Instance.Common_Select, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Grid Grid.Column="1"
                                  Height="36"
                                  HorizontalAlignment="Left"
                                  CornerRadius="8"
                                  Visibility="{x:Bind ThirdPartyToolPath, Converter={StaticResource ObjectToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Height="36"
                                        Padding="16,0,8,1"
                                        BorderThickness="0"
                                        Command="{x:Bind OpenThirdPartyToolFolderCommand}"
                                        CornerRadius="0">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               MaxLines="2"
                                               Text="{x:Bind ThirdPartyToolPath}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </Button>
                                <Button Grid.Column="1"
                                        Height="36"
                                        Padding="0"
                                        BorderThickness="0"
                                        Command="{x:Bind DeleteThirdPartyToolPathCommand}"
                                        CornerRadius="0">
                                    <FontIcon Margin="0,2,2,0"
                                              FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </Grid>

                    </StackPanel>
                </FlipViewItem>

                <FlipViewItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Auto">

                    <StackPanel Spacing="12" Margin="0,0,16,0">
                        <ToggleSwitch Margin="0,0,0,-8"
                                      IsOn="{x:Bind EnableCustomBg, Mode=TwoWay}"
                                      OffContent="{x:Bind lang:Lang.Instance.SettingPage_CustomBackgroundSupportVideo, Mode=OneWay}"
                                      OnContent="{x:Bind lang:Lang.Instance.SettingPage_CustomBackgroundSupportVideo, Mode=OneWay}" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.Instance.SettingPage_BgSizeTip, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Height="36"
                                    BorderThickness="0"
                                    Command="{x:Bind ChangeCustomBgCommand}"
                                    CornerRadius="8"
                                    IsEnabled="{x:Bind EnableCustomBg}"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE91B;" />
                                    <TextBlock Text="{x:Bind lang:Lang.Instance.Common_Select, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Grid Grid.Column="1"
                                  Height="36"
                                  HorizontalAlignment="Left"
                                  CornerRadius="8"
                                  Visibility="{x:Bind CustomBg, Converter={StaticResource ObjectToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Height="36"
                                        BorderThickness="0"
                                        Command="{x:Bind OpenCustomBgCommand}"
                                        CornerRadius="0">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               MaxLines="2"
                                               Text="{x:Bind CustomBg}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </Button>
                                <Button Grid.Column="1"
                                        Height="36"
                                        BorderThickness="0"
                                        Command="{x:Bind DeleteCustomBgCommand}"
                                        CornerRadius="0">
                                    <FontIcon Margin="0,2,2,0"
                                              FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </Grid>

                        <Grid Margin="0,-4,0,-8"
                              ColumnSpacing="12"
                              Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Width="32"
                                    Height="32"
                                    Padding="0"
                                    Command="{x:Bind MuteCommand}"
                                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                                <Grid>
                                    <FontIcon FontSize="16"
                                              Foreground="{ThemeResource ButtonPointerOverBackgroundThemeBrush}"
                                              Glyph="&#xE767;" />
                                    <FontIcon FontSize="16" Glyph="{x:Bind VideoBgVolumeButtonIcon}" />
                                </Grid>
                            </Button>
                            <Slider Grid.Column="1"
                                    Width="200"
                                    HorizontalAlignment="Left"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{x:Bind VideoBgVolume, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Margin="0,0,0,-12"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Text="{x:Bind ChangeBgError}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ChangeBgError, Converter={StaticResource ObjectToVisibilityConverter}}" />

                        <Grid x:Name="Grid_BackgroundDragIn"
                              Height="140"
                              Margin="0,12,0,0"
                              AllowDrop="True"
                              Background="Transparent"
                              DragOver="Grid_BackgroundDragIn_DragOver"
                              Drop="Grid_BackgroundDragIn_Drop">
                            <Rectangle HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       RadiusX="8"
                                       RadiusY="8"
                                       Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                                       StrokeDashArray="4,2"
                                       StrokeThickness="2" />

                            <StackPanel HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                <FontIcon FontSize="24"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Glyph="&#xE91B;" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="16"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_DragAndDropImageOrVideoFiles, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="0">
                            <ToggleSwitch Margin="0,0,0,-4"
                                          IsOn="{x:Bind FpsCapEnabled, Mode=TwoWay}"
                                          OffContent="{x:Bind FpsHeaderText, Mode=OneWay}"
                                          OnContent="{x:Bind FpsHeaderText, Mode=OneWay}" />
                            <StackPanel>
                                <Grid>
                                    <Slider x:Name="Slider_FpsCap"
                                            IsEnabled="{x:Bind FpsCapEnabled, Mode=OneWay}"
                                            Maximum="60"
                                            Minimum="10"
                                            StepFrequency="1"
                                            TickPlacement="BottomRight"
                                            TickFrequency="10"
                                            ValueChanged="Slider_FpsCap_ValueChanged"
                                            Value="{x:Bind FpsSliderValue, Mode=TwoWay}" />

                                    <Border x:Name="FpsBubble"
                                            Background="{ThemeResource ToolTipBackgroundThemeBrush}"
                                            CornerRadius="4"
                                            HorizontalAlignment="Left"
                                            IsHitTestVisible="False"
                                            MinWidth="48"
                                            Padding="6,3"
                                            VerticalAlignment="Top"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="FpsBubbleText"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource ToolTipForegroundThemeBrush}"
                                                   IsTextScaleFactorEnabled="False"
                                                   TextAlignment="Center" />
                                    </Border>
                                </Grid>

                                <Grid>
                                    <TextBlock FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextScaleFactorEnabled="False"
                                               Text="10" />
                                    <TextBlock FontSize="11"
                                               HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextScaleFactorEnabled="False"
                                               Text="60" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <ComboBox MinWidth="200"
                                  Header="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_BgQuality, Mode=OneWay}"
                                  SelectedIndex="{x:Bind BgQualityIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_QualityAuto, Mode=OneWay}" />
                            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_QualityHigh, Mode=OneWay}" />
                            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_QualityMedium, Mode=OneWay}" />
                            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_QualityLow, Mode=OneWay}" />
                        </ComboBox>

                        <ToggleSwitch Margin="0,0,0,-8"
                                      IsOn="{x:Bind PauseOnGameRun, Mode=TwoWay}"
                                      OffContent="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_PauseOnGameRun, Mode=OneWay}"
                                      OnContent="{x:Bind lang:Lang.Instance.GameLauncherSettingDialog_PauseOnGameRun, Mode=OneWay}" />

                    </StackPanel>
                    </ScrollViewer>
                </FlipViewItem>

            </FlipView>

        </NavigationView>

        <Button Width="32"
                Height="32"
                Margin="-20"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderThickness="0"
                Command="{x:Bind CloseCommand}"
                CornerRadius="8"
                Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
            <FontIcon FontSize="16"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Glyph="&#xE711;"
                      IsTextScaleFactorEnabled="False" />
        </Button>

    </Grid>
</ContentDialog>

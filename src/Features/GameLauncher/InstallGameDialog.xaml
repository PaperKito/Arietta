<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Arietta.Features.GameLauncher.InstallGameDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Arietta.Localization"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomDialogAcrylicBrush}"
               BorderThickness="0"
               CornerRadius="8"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ControlFillColorTransparentBrush" />
    </ContentDialog.Resources>

    <Grid Width="560" Padding="24">

        <StackPanel>

            
            <TextBlock FontSize="18"
                       FontWeight="Bold"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind lang:Lang.Instance.InstallGameDialog_SelectInstallationPath, Mode=OneWay}" />

            
            <Grid Height="36"
                  Margin="0,16,0,0"
                  Background="{ThemeResource DateTimePickerFlyoutButtonBackgroundPointerOver}"
                  CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TextBlock_InstallationPath"
                           Margin="12,4,12,4"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           IsTextTrimmedChanged="TextBlock_IsTextTrimmedChanged"
                           MaxLines="2"
                           Text="{x:Bind InstallationPath}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
                
                <Button Grid.Column="1"
                        Padding="12,0,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        BorderThickness="0"
                        Command="{x:Bind ChangeInstallationPathCommand}"
                        CornerRadius="8"
                        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                    <TextBlock FontSize="14"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               IsTextScaleFactorEnabled="False"
                               Text="{x:Bind lang:Lang.Instance.Common_Change, Mode=OneWay}" />
                </Button>
            </Grid>

            
            <cwc:Segmented x:Name="Segmented_Tier"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Stretch"
                           Visibility="{x:Bind TierVisibility}" />

            
            <StackPanel Margin="1,8,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False">
                    <Run Text="{x:Bind lang:Lang.Instance.InstallGameDialog_SpaceRequiredToDownload, Mode=OneWay}" />
                    <Run Text="{x:Bind RequiredBytesText}" />
                </TextBlock>
                
                <Button Padding="4"
                        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                    <FontIcon FontSize="12"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Glyph="&#xE9CE;"
                              IsTextScaleFactorEnabled="False" />
                    <Button.Flyout>
                        <Flyout>
                            <TextBlock MaxWidth="380"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       Text="{x:Bind HardLinkEstimateText}"
                                       TextWrapping="Wrap" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <AppBarSeparator Padding="2" />
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False">
                    <Run Text="{x:Bind lang:Lang.Instance.InstallGameDialog_SpaceAvailable, Mode=OneWay}" />
                    <Run Text="{x:Bind AvailableSpaceText}" />
                </TextBlock>
            </StackPanel>

            
            <TextBlock Margin="1,8,1,0"
                       FontSize="12"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind ErrorMessage}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind ErrorMessage, Converter={StaticResource ObjectToVisibilityConverter}}" />

            
            <Button x:Name="Button_StartInstallation"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Command="{x:Bind StartInstallationCommand}"
                    Content="{x:Bind lang:Lang.Instance.LauncherPage_InstallGame, Mode=OneWay}"
                    FontSize="14"
                    IsEnabled="{x:Bind CanStart}"
                    IsTextScaleFactorEnabled="False"
                    Style="{ThemeResource AccentButtonStyle}" />

        </StackPanel>

        
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind HardLinkVisibility}">
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextScaleFactorEnabled="False">
                <Run Text="{x:Bind lang:Lang.Instance.InstallGameDialog_HardLinkAfterSize, Mode=OneWay}" />
                <Run Text="{x:Bind HardLinkAfterBytesText}" />
            </TextBlock>
            <Button Padding="4"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                <FontIcon FontSize="12"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE9CE;"
                          IsTextScaleFactorEnabled="False" />
                <Button.Flyout>
                    <Flyout>
                        <TextBlock MaxWidth="380"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind lang:Lang.Instance.InstallGameDialog_EstimateOnly, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        
        <Button Width="32"
                Height="32"
                Margin="-20"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderThickness="0"
                Command="{x:Bind CloseCommand}"
                CornerRadius="8"
                Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
            <FontIcon FontSize="16"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Glyph="&#xE711;"
                      IsTextScaleFactorEnabled="False" />
        </Button>

    </Grid>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Arietta.Features.Welcome.WelcomeOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid>
        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.78" />

        <StackPanel MaxWidth="640"
                    Margin="52,64,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Spacing="12">

            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="{x:Bind lang:Lang.Instance.Welcome_Title}" />

            <TextBlock FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.Instance.Welcome_Desc}" TextWrapping="Wrap" />

            <TextBlock FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.Instance.Welcome_DataFolderDesc}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                <TextBlock FontSize="14" Text="{x:Bind DataFolderText}" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0"
                       FontSize="14"
                       Text="{x:Bind lang:Lang.Instance.Welcome_EnvCheckIntro}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon FontSize="16" Glyph="&#xE774;" />
                <TextBlock FontSize="14" Text="{x:Bind lang:Lang.Instance.Welcome_WebView2}" />
                <TextBlock FontSize="14" Foreground="{x:Bind WebView2Brush}" Text="{x:Bind WebView2Text}" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.Instance.Welcome_SuggestIntro}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock FontSize="14" Foreground="{x:Bind TransparencyBrush}" Text="{x:Bind lang:Lang.Instance.Welcome_Transparency}" />
                <TextBlock FontSize="14" Foreground="{x:Bind AnimationBrush}" Text="{x:Bind lang:Lang.Instance.Welcome_Animation}" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.Instance.Welcome_Footer}" TextWrapping="Wrap" />
        </StackPanel>

        <Button Margin="0,0,52,52"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Command="{x:Bind StartCommand}"
                Content="{x:Bind lang:Lang.Instance.Welcome_Start}"
                Style="{ThemeResource AccentButtonStyle}" />
    </Grid>

</UserControl>

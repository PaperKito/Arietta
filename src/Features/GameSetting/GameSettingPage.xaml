<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.GameSetting.GameSettingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <Grid Margin="24,20,24,24" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="12" Visibility="{x:Bind IsBaseSettingEnable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock FontSize="20"
                               FontWeight="Bold"
                               Text="{x:Bind lang:Lang.Instance.GameSettingPage_Resolution, Mode=OneWay}" />
                    <CheckBox Content="{x:Bind lang:Lang.Instance.GameSettingPage_FullScreen, Mode=OneWay}"
                              IsChecked="{x:Bind EnableFullScreen, Mode=TwoWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.Instance.GameSettingPage_PgrFullscreenBlockedTip, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind IsPgrFullscreenBlocked, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <CheckBox Content="{x:Bind lang:Lang.Instance.GameSettingPage_CustomResolution, Mode=OneWay}"
                              IsChecked="{x:Bind EnableCustomResolution, Mode=TwoWay}" />
                    <ComboBox Name="ComboBox_Resolution"
                              Width="160"
                              IsEnabled="{x:Bind IsResolutionListEnabled, Mode=OneWay}"
                              SelectionChanged="ComboBox_Resolution_SelectionChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox Width="120"
                                   IsEnabled="{x:Bind IsCustomResInputEnabled, Mode=OneWay}"
                                   Minimum="0"
                                   Value="{x:Bind ResolutionWidth, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="20"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="×" />
                        <NumberBox Width="120"
                                   IsEnabled="{x:Bind IsCustomResInputEnabled, Mode=OneWay}"
                                   Minimum="0"
                                   Value="{x:Bind ResolutionHeight, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.Instance.GameSettingPage_CustomResolutionTip, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind EnableCustomResolution, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <StackPanel Margin="0,8,0,0"
                                Spacing="12"
                                Visibility="{x:Bind IsLanguageSettingEnable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock FontSize="20"
                                   FontWeight="Bold"
                                   Text="{x:Bind lang:Lang.Instance.GameSettingPage_VoiceLanguage, Mode=OneWay}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.Instance.GameSettingPage_VoiceLanguageDescription, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <ComboBox Width="160"
                                  SelectedIndex="{x:Bind LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_Chinese, Mode=OneWay}" />
                            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_English, Mode=OneWay}" />
                            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_Japanese, Mode=OneWay}" />
                            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_Korean, Mode=OneWay}" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Spacing="12"
                            Visibility="{x:Bind IsHdrSettingEnable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock FontSize="20"
                               FontWeight="Bold"
                               Text="{x:Bind lang:Lang.Instance.GameSettingPage_HDR, Mode=OneWay}" />
                    <CheckBox Content="{x:Bind lang:Lang.Instance.GameSettingPage_EnableHDR, Mode=OneWay}"
                              IsChecked="{x:Bind EnableHDR, Mode=TwoWay}" />
                    <InfoBar Margin="0,0,24,0"
                             IsClosable="False"
                             IsOpen="True"
                             Severity="Warning"
                             Title="{x:Bind lang:Lang.Instance.GameSettingPage_HDRNotSupported, Mode=OneWay}"
                             Visibility="{x:Bind HDRNotSupported, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <InfoBar Margin="0,0,24,0"
                             IsClosable="False"
                             IsOpen="True"
                             Severity="Warning"
                             Title="{x:Bind lang:Lang.Instance.GameSettingPage_HDRNotEnabled, Mode=OneWay}"
                             Visibility="{x:Bind HDRNotEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <StackPanel Name="StackPanel_NotInstalled"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="Collapsed">
            <FontIcon HorizontalAlignment="Center"
                      FontSize="48"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Glyph="&#xE7FC;"
                      IsTextScaleFactorEnabled="False" />
            <StackPanel Spacing="8">
                <TextBlock Name="TextBlock_GameNotInstalled"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           Text="{x:Bind lang:Lang.Instance.GameSettingPage_GameNotInstalled, Mode=OneWay}" />
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.Instance.GameSettingPage_GameNotInstalledDesc, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <Grid Name="Grid_ApplyBackground"
              Grid.Row="1"
              Background="{ThemeResource CustomOverlayAcrylicBrush}"
              CornerRadius="8,0,0,0">

            <StackPanel Margin="24,0,24,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Height="36"
                        BorderThickness="0"
                        Command="{x:Bind ApplySettingCommand}"
                        CornerRadius="18"
                        IsEnabled="{x:Bind IsApplyButtonEnable}"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Margin="12,0,12,0"
                                Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon VerticalAlignment="Center"
                                  FontSize="16"
                                  Glyph="&#xE8FB;"
                                  IsTextScaleFactorEnabled="False" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.Common_Apply, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <TextBlock Margin="24,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ErrorMessage}"
                           TextTrimming="WordEllipsis" />
            </StackPanel>
        </Grid>

    </Grid>
</mf:PageBase>

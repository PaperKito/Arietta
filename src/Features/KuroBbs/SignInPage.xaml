<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.KuroBbs.SignInPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="8" Margin="0,4,0,12">
            <Button x:Name="Button_Refresh"
                    Click="Button_Refresh_Click"
                    Style="{StaticResource KuroBbsEdgeButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.RolePage_Refresh, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button x:Name="Button_SignIn"
                    Click="Button_SignIn_Click"
                    Content="{x:Bind lang:Lang.Instance.SignPage_DoSignIn, Mode=OneWay}"
                    Style="{StaticResource KuroBbsEdgeButtonStyle}" />
        </StackPanel>

        <InfoBar x:Name="InfoBar_NoAccount"
                 Grid.Row="1"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsClosable="False"
                 IsOpen="False"
                 Severity="Warning"
                 Title="{x:Bind lang:Lang.Instance.RolePage_NoAccount, Mode=OneWay}"
                 Message="{x:Bind lang:Lang.Instance.RolePage_NoAccountDesc, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1" Padding="0,0,16,16">
            <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">

                
                <Border Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock FontSize="15" FontWeight="Bold" Text="{x:Bind lang:Lang.Instance.SignPage_MonthlySign, Mode=OneWay}" />
                                    <TextBlock x:Name="TextBlock_SignStatus"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="TextBlock_SignProgress"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                <ProgressRing x:Name="ProgressRing_Loading" Width="20" Height="20" IsActive="False" />
                                <ToggleSwitch x:Name="Toggle_AutoSign"
                                              MinWidth="0"
                                              Padding="0"
                                              Toggled="Toggle_AutoSign_Toggled">
                                    <ToggleSwitch.Header>
                                        <TextBlock FontSize="12" Text="{x:Bind lang:Lang.Instance.SignPage_AutoSign, Mode=OneWay}" />
                                    </ToggleSwitch.Header>
                                </ToggleSwitch>
                            </StackPanel>
                        </Grid>

                        
                        <GridView x:Name="GridView_Goods" SelectionMode="None" IsItemClickEnabled="False">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="84" Height="100"
                                          CornerRadius="8"
                                          Padding="6,4,6,6"
                                          Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <StackPanel Spacing="3">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{Binding DayBrush}"
                                                       Text="{Binding DayText}" />
                                            <Border CornerRadius="6"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    Opacity="{Binding DimOpacity}">
                                                <Image Width="46" Height="46" Source="{Binding IconSource}" />
                                            </Border>
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding GoodsText}" />
                                        </StackPanel>
                                        
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="8"
                                                Padding="4,0,4,0"
                                                Visibility="{Binding SignedVisibility}">
                                            <TextBlock FontSize="10" Foreground="White" Text="✓" />
                                        </Border>
                                        
                                        <Border CornerRadius="8"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                BorderThickness="2"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding NextVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</mf:PageBase>

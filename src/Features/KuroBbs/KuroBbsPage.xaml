<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.KuroBbs.KuroBbsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:local="using:Arietta.Features.KuroBbs"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid>

        <NavigationView Name="NavigationView_KuroBbs"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        ItemInvoked="NavigationView_KuroBbs_ItemInvoked"
                        OpenPaneLength="248"
                        PaneDisplayMode="Left">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewHeaderMargin">0</Thickness>
                <x:Double x:Key="PaneToggleButtonHeight">0</x:Double>
            </NavigationView.Resources>

            <NavigationView.PaneCustomContent>
                <Grid Height="56"
                      HorizontalAlignment="Stretch"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Name="Grid_Avatar"
                          Width="56"
                          Height="56"
                          Margin="8,0,0,0"
                          Background="Transparent"
                          Tapped="Grid_Avatar_Tapped">
                        <Border Name="Border_Avatar"
                                Margin="6"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="100">
                            <Grid>
                                <Image x:Name="Image_Avatar"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed" />
                                <TextBlock Name="TextBlock_AvatarChar"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2"
                                x:Name="StackPanel_RoleInfo"
                                Visibility="Collapsed">
                        <TextBlock x:Name="TextBlock_AccountName" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run x:Name="Run_AccountRegion" /><Run Text="" />
                            <Run x:Name="Run_AccountLevelLabel" Text="{x:Bind lang:Lang.Instance.KuroBbs_AccountLevelLabel, Mode=OneWay}" /><Run x:Name="Run_AccountLevel" />
                        </TextBlock>
                    </StackPanel>

                    <Button x:Name="Button_AccountSwitcher"
                            Grid.Column="2"
                            Width="28"
                            Height="44"
                            Margin="0,0,12,0"
                            Padding="0"
                            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                        <StackPanel Spacing="-6">
                            <FontIcon FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE70E;" />
                            <FontIcon FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE70D;" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="Flyout_Accounts" Placement="BottomEdgeAlignedRight">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="{ThemeResource CustomAcrylicBrush}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="4" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Grid MinWidth="240" Padding="0,8,0,8" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="4,0,4,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="Button_RefreshInfo_Click"
                                            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontSize="16" Glyph="&#xE72C;" />
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.KuroBbs_RefreshInfo, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="4,0,4,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="Button_Login_Click"
                                            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.KuroBbs_Login, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>

                                    <MenuFlyoutSeparator Grid.Row="1" Grid.ColumnSpan="2" />

                                    <ListView Name="ListView_Accounts"
                                              Grid.Row="2"
                                              Grid.ColumnSpan="2"
                                              SelectionMode="Single"
                                              SelectionChanged="ListView_Accounts_SelectionChanged">
                                        <ListView.ItemTemplate>

                                            <DataTemplate x:DataType="local:AccountItem">
                                                <Grid Padding="0,6,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="32"
                                                            Height="32"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            CornerRadius="100">
                                                        <Image Source="{Binding AvatarSource}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding RoleName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding SubText}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Width="36"
                                                            Height="28"
                                                            Padding="0"
                                                            VerticalAlignment="Stretch"
                                                            Content="&#xE712;"
                                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="RightEdgeAlignedTop">
                                                                <MenuFlyoutItem Click="MenuFlyoutItem_SwitchRole_Click"
                                                                                Tag="{Binding}"
                                                                                Text="{x:Bind lang:Lang.Instance.KuroBbs_SwitchRole, Mode=OneWay}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE8A5;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Click="MenuFlyoutItem_DeleteAccount_Click"
                                                                                Tag="{Binding}"
                                                                                Text="{x:Bind lang:Lang.Instance.KuroBbs_ClearAccount, Mode=OneWay}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE74D;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                </Grid>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItemSeparator />

                <NavigationViewItem Name="NavigationViewItem_SignIn"
                                    IsSelected="True"
                                    Tag="SignIn">
                    <NavigationViewItem.Content>
                        <Grid Height="40"
                              Margin="-2,0,0,0"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="Image_SignIn"
                                   Width="26"
                                   Height="26"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Source="ms-appx:///Assets/Image/Common/CheckIn.png" />
                            <TextBlock x:Name="TextBlock_SignIn"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind lang:Lang.Instance.KuroBbs_SignIn, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Name="NavigationViewItem_PgrResource"
                                    Tag="PgrResource">
                    <NavigationViewItem.Content>
                        <Grid Height="40"
                              Margin="-2,0,0,0"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <BitmapIcon Width="24"
                                        Height="24"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        UriSource="ms-appx:///Assets/Image/Common/KuroBbsNav_ResourceReport_Dark.png"
                                        ShowAsMonochrome="True"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind lang:Lang.Instance.KuroBbs_PgrResource, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Name="NavigationViewItem_PgrRole"
                                    Tag="PgrRole">
                    <NavigationViewItem.Content>
                        <Grid Height="40"
                              Margin="-2,0,0,0"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="24"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Glyph="&#xE716;" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind lang:Lang.Instance.KuroBbs_PgrRole, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Name="NavigationViewItem_PgrCage"
                                    Tag="PgrCage">
                    <NavigationViewItem.Content>
                        <Grid Height="40"
                              Margin="-2,0,0,0"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <BitmapIcon Width="24"
                                        Height="24"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        UriSource="ms-appx:///Assets/Image/Combat/PgrChallenge_Cage_Dark.png"
                                        ShowAsMonochrome="True"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind lang:Lang.Instance.KuroBbs_PgrCage, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Name="NavigationViewItem_PgrWarArea"
                                    Tag="PgrWarArea">
                    <NavigationViewItem.Content>
                        <Grid Height="40"
                              Margin="-2,0,0,0"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <BitmapIcon Width="24"
                                        Height="24"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        UriSource="ms-appx:///Assets/Image/Combat/PgrChallenge_War_Dark.png"
                                        ShowAsMonochrome="True"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind lang:Lang.Instance.KuroBbs_PgrWarArea, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Name="NavigationViewItem_PgrTransfinite"
                                    Tag="PgrTransfinite">
                    <NavigationViewItem.Content>
                        <Grid Height="40"
                              Margin="-2,0,0,0"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <BitmapIcon Width="24"
                                        Height="24"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        UriSource="ms-appx:///Assets/Image/Combat/PgrChallenge_Reflect_Dark.png"
                                        ShowAsMonochrome="True"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind lang:Lang.Instance.KuroBbs_PgrTransfinite, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Name="NavigationViewItem_Role"
                                    Tag="Role">
                    <NavigationViewItem.Content>
                        <Grid Height="40"
                              Margin="-2,0,0,0"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <BitmapIcon Width="24"
                                        Height="24"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        UriSource="ms-appx:///Assets/Image/Common/KuroBbsNav_Resonator_Dark.png"
                                        ShowAsMonochrome="True"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind lang:Lang.Instance.KuroBbs_Role, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Name="NavigationViewItem_ResourceBrief"
                                    Tag="ResourceBrief">
                    <NavigationViewItem.Content>
                        <Grid Height="40"
                              Margin="-2,0,0,0"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Image Width="26"
                                   Height="26"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Source="ms-appx:///Assets/Image/Common/ResourceBrief.gif" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind lang:Lang.Instance.KuroBbs_ResourceBrief, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Name="NavigationViewItem_TowerOfAdversity"
                                    Tag="TowerOfAdversity">
                    <NavigationViewItem.Content>
                        <Grid Height="40"
                              Margin="-2,0,0,0"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <BitmapIcon Width="24"
                                        Height="24"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        UriSource="ms-appx:///Assets/Image/Combat/WutheringChallenge_Tower_Dark.png"
                                        ShowAsMonochrome="True"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind lang:Lang.Instance.KuroBbs_TowerOfAdversity, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Name="NavigationViewItem_SongOfVoidSea"
                                    Tag="SongOfVoidSea">
                    <NavigationViewItem.Content>
                        <Grid Height="40"
                              Margin="-2,0,0,0"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <BitmapIcon Width="24"
                                        Height="24"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        UriSource="ms-appx:///Assets/Image/Combat/WutheringChallenge_VoidSea_Dark.png"
                                        ShowAsMonochrome="True"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind lang:Lang.Instance.KuroBbs_SongOfVoidSea, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Name="NavigationViewItem_DoomsdayMatrix"
                                    Tag="DoomsdayMatrix">
                    <NavigationViewItem.Content>
                        <Grid Height="40"
                              Margin="-2,0,0,0"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <BitmapIcon Width="24"
                                        Height="24"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        UriSource="ms-appx:///Assets/Image/Combat/WutheringChallenge_Matrix_Dark.png"
                                        ShowAsMonochrome="True"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind lang:Lang.Instance.KuroBbs_DoomsdayMatrix, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItemSeparator />
                <NavigationViewItem Name="NavigationViewItem_DataTerminal"
                                    Tag="DataTerminal">
                    <NavigationViewItem.Content>
                        <Grid Height="40"
                              Margin="-2,0,0,0"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="Image_DataTerminal"
                                   Width="26"
                                   Height="26"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                            <TextBlock x:Name="TextBlock_DataTerminal"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind lang:Lang.Instance.KuroBbs_DataTerminal, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <NavigationViewItem x:Name="NavigationViewItem_ModuleSettings"
                                    Margin="-2,0,0,-4"
                                    Tapped="NavigationViewItem_ModuleSettings_Tapped">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.KuroBbs_Settings, Mode=OneWay}" />
                    </NavigationViewItem.Content>
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Top">
                            <StackPanel MinWidth="220" Spacing="8">
                                <TextBlock FontSize="16" Text="{x:Bind lang:Lang.Instance.KuroBbs_Settings, Mode=OneWay}" />
                                <ToggleSwitch x:Name="Toggle_KuroCommunitySign"
                                              HorizontalAlignment="Left"
                                              OffContent="{x:Bind lang:Lang.Instance.SettingPage_KuroCommunitySign, Mode=OneWay}"
                                              OnContent="{x:Bind lang:Lang.Instance.SettingPage_KuroCommunitySign, Mode=OneWay}"
                                              Toggled="Toggle_KuroCommunitySign_Toggled" />
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>
            </NavigationView.PaneFooter>

            <Frame Name="Frame_KuroBbs" Margin="0,8,0,0" />

        </NavigationView>

    </Grid>

</mf:PageBase>

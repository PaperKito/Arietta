<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.KuroBbs.PgrRolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" x:Name="StackPanel_TopBar" Orientation="Vertical" Spacing="8" Margin="0,4,0,6">
            <Button x:Name="Button_Refresh"
                    Click="Button_Refresh_Click"
                    Style="{StaticResource KuroBbsEdgeButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.RolePage_Refresh, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="ScrollViewer_Roles">
            <StackPanel Spacing="12">
                <ProgressRing x:Name="ProgressRing_Loading"
                              IsActive="False"
                              Visibility="Collapsed" />
                <InfoBar x:Name="InfoBar_Error"
                         IsOpen="False"
                         Visibility="Collapsed"
                         Severity="Error" />
                <InfoBar x:Name="InfoBar_NoAccount"
                         IsOpen="False"
                         Visibility="Collapsed"
                         Severity="Warning"
                         Message="{x:Bind lang:Lang.Instance.PgrData_NoRole, Mode=OneWay}" />

                <GridView x:Name="GridView_Roles"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="GridView_Roles_ItemClick">
                    <GridView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150"
                                    Margin="4"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    
                                    <Grid>
                                        <Border Height="150"
                                                CornerRadius="7,7,0,0"
                                                Background="{ThemeResource ControlFillColorTertiaryBrush}">
                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        
                                        <Border Height="4"
                                                VerticalAlignment="Bottom"
                                                CornerRadius="0,0,0,0"
                                                Background="{Binding RankBrush}" />
                                    </Grid>
                                    <StackPanel Padding="10,8,10,10" Spacing="4">
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding BodyName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding ElementText}" />
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Text="{Binding FightText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </ScrollViewer>

        
        <Grid Grid.Row="1" x:Name="Grid_Detail" Visibility="Collapsed" Background="{ThemeResource CustomOverlayAcrylicBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Margin="0,6,0,6"
                    Click="Button_CloseDetail_Click"
                    Style="{StaticResource KuroBbsEdgeButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    <TextBlock Text="{x:Bind lang:Lang.Instance.RolePage_Back, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <ScrollViewer Grid.Row="1" Padding="16,0,24,24">
                <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Left">

                    
                    <Border Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="380" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            
                            <StackPanel x:Name="StackPanel_DetailInfo"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Spacing="12">

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="TextBlock_DetailName"
                                               VerticalAlignment="Bottom"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TextBlock_DetailLevel"
                                               Margin="0,0,0,5"
                                               VerticalAlignment="Bottom"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <StackPanel x:Name="StackPanel_DetailBadges"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="6" />
                                    <HyperlinkButton x:Name="HyperlinkButton_DetailWiki"
                                                     Padding="0"
                                                     VerticalAlignment="Center"
                                                     Click="HyperlinkButton_DetailWiki_Click"
                                                     FontSize="12"
                                                     Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                            <TextBlock Text="{x:Bind lang:Lang.Instance.PgrRoleDetail_Wiki, Mode=OneWay}" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </StackPanel>

                                
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="6" MinWidth="150">
                                        <StackPanel Spacing="1">
                                            <TextBlock FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind lang:Lang.Instance.PgrRoleDetail_Grade, Mode=OneWay}" />
                                            
                                            <TextBlock x:Name="TextBlock_DetailGrade"
                                                       FontSize="30"
                                                       FontWeight="Bold" />
                                        </StackPanel>
                                        <StackPanel Spacing="1" Margin="0,4,0,0">
                                            <TextBlock FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind lang:Lang.Instance.PgrRoleDetail_Fight, Mode=OneWay}" />
                                            <TextBlock x:Name="TextBlock_DetailFight"
                                                       FontSize="30"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    
                                    <StackPanel x:Name="StackPanel_GearIcons"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Orientation="Horizontal"
                                                Spacing="12" />
                                </Grid>

                                
                                <Grid x:Name="Grid_EquipIcons"
                                      HorizontalAlignment="Left"
                                      ColumnSpacing="8"
                                      RowSpacing="8" />
                            </StackPanel>

                            
                            <StackPanel x:Name="StackPanel_PortraitWrap"
                                        Grid.Column="1"
                                        Width="320"
                                        Spacing="5">
                                <Border x:Name="Border_Portrait"
                                        Height="360"
                                        CornerRadius="12"
                                        BorderThickness="2"
                                        Background="{ThemeResource ControlFillColorTertiaryBrush}">
                                    <Image x:Name="Image_DetailRole"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    
                    <ProgressRing x:Name="ProgressRing_Detail"
                                  HorizontalAlignment="Left"
                                  IsActive="False" />

                    <InfoBar x:Name="InfoBar_DetailError"
                             IsOpen="False"
                             Severity="Error" />

                    <StackPanel x:Name="StackPanel_Deep" Spacing="12" />

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>

</mf:PageBase>

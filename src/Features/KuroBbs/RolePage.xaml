<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.KuroBbs.RolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,4,0,10">
            <Button Style="{StaticResource KuroBbsEdgeButtonStyle}" Click="Button_Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.RolePage_Refresh, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="20" FontWeight="Bold" Text="{x:Bind lang:Lang.Instance.KuroBbs_Role, Mode=OneWay}" />
            <ProgressRing x:Name="ProgressRing_Loading"
                          Width="20" Height="20"
                          VerticalAlignment="Center"
                          IsActive="False" />
        </StackPanel>

        
        <InfoBar x:Name="InfoBar_NoAccount"
                 Grid.Row="1"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsClosable="False"
                 IsOpen="False"
                 Severity="Warning"
                 Title="{x:Bind lang:Lang.Instance.RolePage_NoAccount, Mode=OneWay}"
                 Message="{x:Bind lang:Lang.Instance.RolePage_NoAccountDesc, Mode=OneWay}" />

        
        <InfoBar x:Name="InfoBar_Error"
                 Grid.Row="1"
                 VerticalAlignment="Top"
                 IsClosable="True"
                 IsOpen="False"
                 Severity="Error"
                 Title="{x:Bind lang:Lang.Instance.RolePage_LoadFailed, Mode=OneWay}" />

        
        <ScrollView Grid.Row="1" x:Name="ScrollView_Roles" VerticalScrollMode="Disabled" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden">
            <GridView x:Name="GridView_Roles"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="GridView_Roles_ItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="92" Spacing="3">
                            <Grid Height="92" CornerRadius="8">
                                <Border CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Image Stretch="UniformToFill" Source="{Binding IconSource}" />
                                </Border>
                                
                                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,0"
                                        Padding="5,1" CornerRadius="0,8,0,6"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{Binding ChainVisibility}">
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="White" Text="{Binding ChainText}" />
                                </Border>
                                
                                <Border Height="3" VerticalAlignment="Bottom" CornerRadius="0,0,8,8"
                                        Background="{Binding StarBrush}" />
                            </Grid>
                            <TextBlock HorizontalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{Binding LevelText}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding RoleName}" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollView>

        
        <Grid Grid.Row="1" x:Name="Grid_Detail" Visibility="Collapsed" Background="{ThemeResource CustomOverlayAcrylicBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Margin="0,6,0,6"
                    Click="Button_CloseDetail_Click"
                    Style="{StaticResource KuroBbsEdgeButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    <TextBlock Text="{x:Bind lang:Lang.Instance.RolePage_Back, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <ScrollViewer Grid.Row="1" Padding="16,0,24,24">
                <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Left">

                    
                    <Border Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                
                                <ColumnDefinition Width="*" MinWidth="380" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            
                            
                            <StackPanel x:Name="StackPanel_Info"
                                        Grid.Column="0"
                                        MaxWidth="520"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Spacing="10">

                                
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="TextBlock_DetailName"
                                               VerticalAlignment="Bottom"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TextBlock_DetailLevel"
                                               Margin="0,0,0,5"
                                               VerticalAlignment="Bottom"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                
                                <Border x:Name="Border_Weapon"
                                        Padding="10,8"
                                        CornerRadius="8"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <StackPanel Spacing="8">
                                        <StackPanel x:Name="Panel_Weapon" Orientation="Horizontal" Spacing="10">
                                            
                                            <Border x:Name="Border_WeaponIcon"
                                                    Width="52"
                                                    Height="52"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource ControlFillColorTertiaryBrush}">
                                                <Image x:Name="Image_Weapon" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock x:Name="TextBlock_WeaponName"
                                                           MaxWidth="180"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="TextBlock_WeaponLevel"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel x:Name="Panel_WeaponEffect" Spacing="2">
                                            <TextBlock x:Name="TextBlock_WeaponEffectName"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="TextBlock_WeaponEffect"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                
                                <Border Padding="12,10"
                                        CornerRadius="8"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <StackPanel x:Name="StackPanel_Attributes" Spacing="5" />
                                </Border>

                                
                                <Border x:Name="Border_Skills"
                                        Padding="10,8"
                                        CornerRadius="8"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <StackPanel x:Name="Panel_Skills" Spacing="4" />
                                </Border>
                            </StackPanel>

                            
                            <Image x:Name="Image_DetailRole"
                                   Grid.Column="1"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Stretch="Fill" />

                            
                            <StackPanel x:Name="StackPanel_ChainIcons"
                                        Grid.Column="2"
                                        Margin="0,0,6,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Orientation="Vertical"
                                        Spacing="5" />
                        </Grid>
                    </Border>

                    
                    <StackPanel x:Name="Panel_Phantoms" Spacing="6">
                        <TextBlock FontSize="16" FontWeight="Bold" Text="{x:Bind lang:Lang.Instance.RolePage_Phantoms, Mode=OneWay}" />
                        <TextBlock x:Name="TextBlock_PhantomCost" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="StackPanel_Phantoms" Spacing="8" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>

</mf:PageBase>

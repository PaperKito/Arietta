<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.KuroBbs.CombatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:kuro="using:Arietta.Features.KuroBbs"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,4,0,10">
            <Button Style="{StaticResource KuroBbsEdgeButtonStyle}" Click="Button_Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.RolePage_Refresh, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <TextBlock x:Name="TextBlock_Title"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       FontSize="20"
                       FontWeight="Bold" />
            <TextBlock x:Name="TextBlock_SeasonTime"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressRing x:Name="ProgressRing_Loading" Width="20" Height="20" VerticalAlignment="Center" IsActive="False" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="Scroll_Periods"
                          Grid.Column="0"
                          Margin="10,0,16,16"
                          HorizontalAlignment="Left"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <kuro:PeriodListView x:Name="ListView_Periods"
                          HorizontalAlignment="Left"
                          IsItemClickEnabled="False"
                          IsSwipeEnabled="False"
                          SelectionMode="Single"
                          SelectionChanged="ListView_Periods_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="kuro:CombatPeriodItem">

                            <Border Margin="0,0,14,0"
                                    Padding="12,6,12,6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                <StackPanel Spacing="4">

                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind DateLabel}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel HorizontalAlignment="Center" MinHeight="18" Orientation="Horizontal" Spacing="5">

                                    <Image Width="16"
                                           Height="16"
                                           VerticalAlignment="Center"
                                           Source="ms-appx:///Assets/Image/Combat/TowerStar.png"
                                           Visibility="{x:Bind StarIconVisibility}" />

                                    <Image Width="{x:Bind RankIconSize}"
                                           VerticalAlignment="Center"
                                           Source="{x:Bind RankSource}"
                                           Visibility="{x:Bind RankIconVisibility}" />

                                    <TextBlock FontSize="13"
                                               Text="{x:Bind ValueLabel}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>

                        <Style TargetType="ListViewItem" BasedOn="{StaticResource KuroBbsPeriodItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </kuro:PeriodListView>
            </ScrollViewer>

            <InfoBar x:Name="InfoBar_NoAccount"
                     Grid.Column="1"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsClosable="False"
                     IsOpen="False"
                     Severity="Warning"
                     Title="{x:Bind lang:Lang.Instance.RolePage_NoAccount, Mode=OneWay}"
                     Message="{x:Bind lang:Lang.Instance.RolePage_NoAccountDesc, Mode=OneWay}" />

            <ScrollViewer Grid.Column="1" Padding="0,0,16,16">
                <StackPanel x:Name="StackPanel_Content" Spacing="16" />
            </ScrollViewer>
        </Grid>
    </Grid>

</mf:PageBase>

<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.KuroBbs.PgrResourcePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:kuro="using:Arietta.Features.KuroBbs"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="10" Margin="0,4,12,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Click="Button_Refresh_Click" Style="{StaticResource KuroBbsEdgeButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.RolePage_Refresh, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <kuro:PeriodListView Grid.Row="1"
                                 x:Name="ListView_Periods"
                                 HorizontalAlignment="Left"
                                 SelectionMode="Single"
                                 SelectionChanged="ListView_Periods_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>

                        <Border Margin="0,0,14,0"
                                Padding="12,9,12,9"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8">
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="13" Text="{Binding Title}" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Image Width="14"
                                           Height="14"
                                           VerticalAlignment="Center"
                                           Source="ms-appx:///Assets/Image/Common/blackCard.png" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Subtitle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource KuroBbsPeriodItemStyle}">

                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListView.ItemContainerStyle>
            </kuro:PeriodListView>

            <ProgressRing Grid.Row="2"
                          x:Name="ProgressRing_Loading"
                          Width="20"
                          Height="20"
                          HorizontalAlignment="Left"
                          IsActive="False" />
        </Grid>

        <Grid Grid.Column="1">
            <InfoBar x:Name="InfoBar_NoAccount"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsClosable="False"
                     IsOpen="False"
                     Severity="Warning"
                     Title="{x:Bind lang:Lang.Instance.RolePage_NoAccount, Mode=OneWay}"
                     Message="{x:Bind lang:Lang.Instance.RolePage_NoAccountDesc, Mode=OneWay}" />

            <ScrollViewer x:Name="ScrollViewer_Content" Padding="0,4,16,16">

                <StackPanel Spacing="16">

                    <InfoBar x:Name="InfoBar_Error"
                             IsOpen="False"
                             Severity="Error" />

                    <TextBlock x:Name="TextBlock_PeriodTitle" FontSize="18" FontWeight="Bold" />

                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.Instance.ResourceBrief_TotalGain, Mode=OneWay}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="8">
                                    <Image Width="22" Height="22" Source="ms-appx:///Assets/Image/Common/blackCard.png" />
                                    <TextBlock x:Name="TextBlock_TotalBlackCard" FontSize="22" FontWeight="Bold" Text="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <Image Width="22" Height="22" Source="ms-appx:///Assets/Image/Common/developResource.png" />
                                    <TextBlock x:Name="TextBlock_TotalDevelop" FontSize="22" FontWeight="Bold" Text="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Image Width="22" Height="22" Source="ms-appx:///Assets/Image/Common/tradeCredit.png" />
                                    <TextBlock x:Name="TextBlock_TotalTrade" FontSize="22" FontWeight="Bold" Text="0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="15" FontWeight="Bold" Text="{x:Bind lang:Lang.Instance.PgrResource_Composition, Mode=OneWay}" />
                            <StackPanel x:Name="StackPanel_Composition" Spacing="14" />
                        </StackPanel>
                    </Border>

                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="15" FontWeight="Bold" Text="{x:Bind lang:Lang.Instance.PgrResource_MonthlyData, Mode=OneWay}" />
                            <StackPanel x:Name="StackPanel_Items" Spacing="4" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

</mf:PageBase>

<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.KuroBbs.ResourceBriefPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             mc:Ignorable="d">

    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        
        <StackPanel Grid.Column="0" Spacing="10" Margin="0,4,12,0">
            <Button Click="Button_Refresh_Click" Style="{StaticResource KuroBbsEdgeButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.RolePage_Refresh, Mode=OneWay}" />
                </StackPanel>
            </Button>
            
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="Button_Month"
                        Padding="8,3,8,3" CornerRadius="6" FontSize="12"
                        Background="Transparent" BorderThickness="0"
                        Click="Button_PeriodType_Click" Tag="month"
                        Content="{x:Bind lang:Lang.Instance.ResourceBrief_Month, Mode=OneWay}" />
                <Button x:Name="Button_Week"
                        Padding="8,3,8,3" CornerRadius="6" FontSize="12"
                        Background="Transparent" BorderThickness="0"
                        Click="Button_PeriodType_Click" Tag="week"
                        Content="{x:Bind lang:Lang.Instance.ResourceBrief_Week, Mode=OneWay}" />
                <Button x:Name="Button_Version"
                        Padding="8,3,8,3" CornerRadius="6" FontSize="12"
                        Background="Transparent" BorderThickness="0"
                        Click="Button_PeriodType_Click" Tag="version"
                        Content="{x:Bind lang:Lang.Instance.ResourceBrief_Version, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Margin="4,6,0,0"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.Instance.ResourceBrief_Detail, Mode=OneWay}" />
            <ListView x:Name="ListView_Periods"
                      SelectionMode="Single"
                      SelectionChanged="ListView_Periods_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4,2,4" Spacing="1">
                            <TextBlock FontSize="13" Text="{Binding Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ProgressRing x:Name="ProgressRing_Loading"
                          Width="20"
                          Height="20"
                          HorizontalAlignment="Left"
                          IsActive="False" />
        </StackPanel>

        
        <Grid Grid.Column="1">
            <InfoBar x:Name="InfoBar_NoAccount"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsClosable="False"
                     IsOpen="False"
                     Severity="Warning"
                     Title="{x:Bind lang:Lang.Instance.RolePage_NoAccount, Mode=OneWay}"
                     Message="{x:Bind lang:Lang.Instance.RolePage_NoAccountDesc, Mode=OneWay}" />

            <ScrollViewer Padding="0,4,16,16">
                
                <StackPanel Spacing="16">

                    <TextBlock x:Name="TextBlock_PeriodTitle" FontSize="18" FontWeight="Bold" />

                    
                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.Instance.ResourceBrief_TotalGain, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="40">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Width="22"
                                           Height="22"
                                           Source="ms-appx:///Assets/Image/Common/star.png" />
                                    <TextBlock x:Name="TextBlock_TotalStar" FontSize="22" FontWeight="Bold" Text="0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Width="22"
                                           Height="22"
                                           Source="ms-appx:///Assets/Image/Common/coin.png" />
                                    <TextBlock x:Name="TextBlock_TotalCoin" FontSize="22" FontWeight="Bold" Text="0" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.Instance.ResourceBrief_StarComposition, Mode=OneWay}" />
                            <Border x:Name="Border_StarBarHost" Height="18" CornerRadius="9"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <StackPanel x:Name="StackPanel_StarBar" Orientation="Horizontal" />
                            </Border>
                            <StackPanel x:Name="StackPanel_StarLegend" Orientation="Horizontal" Spacing="12" />

                            <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.Instance.ResourceBrief_CoinComposition, Mode=OneWay}" />
                            <Border Height="18" CornerRadius="9"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <StackPanel x:Name="StackPanel_CoinBar" Orientation="Horizontal" />
                            </Border>
                            <StackPanel x:Name="StackPanel_CoinLegend" Orientation="Horizontal" Spacing="12" />
                        </StackPanel>
                    </Border>

                    
                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="15" FontWeight="Bold" Text="{x:Bind lang:Lang.Instance.ResourceBrief_Detail, Mode=OneWay}" />
                            <StackPanel x:Name="StackPanel_Items" Spacing="4" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

</mf:PageBase>

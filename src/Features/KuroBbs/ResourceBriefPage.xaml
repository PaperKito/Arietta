<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.KuroBbs.ResourceBriefPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:kuro="using:Arietta.Features.KuroBbs"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             mc:Ignorable="d">

    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="10" Margin="0,4,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Click="Button_Refresh_Click" Style="{StaticResource KuroBbsEdgeButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.RolePage_Refresh, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <kuro:PeriodListView Grid.Row="1"
                      x:Name="ListView_Periods"
                      HorizontalAlignment="Left"
                      Margin="10,0,0,0"
                      SelectionMode="Single"
                      SelectionChanged="ListView_Periods_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>

                        <Border Margin="0,0,14,0"
                                Padding="12,9,12,9"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8">
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="16" Text="{Binding Title}" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding HasStar}">
                                    <Image Width="20"
                                           Height="20"
                                           Source="ms-appx:///Assets/Image/Common/star.png" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{Binding StarText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>

                    <Style TargetType="ListViewItem" BasedOn="{StaticResource KuroBbsPeriodItemStyle}">
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListView.ItemContainerStyle>
            </kuro:PeriodListView>
            <ProgressRing Grid.Row="2"
                          x:Name="ProgressRing_Loading"
                          Width="20"
                          Height="20"
                          HorizontalAlignment="Left"
                          IsActive="False" />
        </Grid>

        <Grid Grid.Column="1">
            <InfoBar x:Name="InfoBar_NoAccount"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsClosable="False"
                     IsOpen="False"
                     Severity="Warning"
                     Title="{x:Bind lang:Lang.Instance.RolePage_NoAccount, Mode=OneWay}"
                     Message="{x:Bind lang:Lang.Instance.RolePage_NoAccountDesc, Mode=OneWay}" />

            <ScrollViewer x:Name="ScrollViewer_Content" Padding="0,4,16,16">

                <StackPanel Spacing="16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TextBlock_PeriodTitle"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold" />
                        <Button x:Name="Button_PeriodType"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Padding="14,3,10,3"
                                CornerRadius="13"
                                FontSize="13"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="TextBlock_PeriodType"
                                           Text="{x:Bind lang:Lang.Instance.ResourceBrief_Month, Mode=OneWay}" />
                                <FontIcon FontSize="10" Glyph="&#xE70D;" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <RadioMenuFlyoutItem Tag="month"
                                                         GroupName="BriefPeriodType"
                                                         IsChecked="True"
                                                         Click="Menu_PeriodType_Click"
                                                         Text="{x:Bind lang:Lang.Instance.ResourceBrief_Month, Mode=OneWay}" />
                                    <RadioMenuFlyoutItem Tag="version"
                                                         GroupName="BriefPeriodType"
                                                         Click="Menu_PeriodType_Click"
                                                         Text="{x:Bind lang:Lang.Instance.ResourceBrief_Version, Mode=OneWay}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.Instance.ResourceBrief_TotalGain, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="40">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Width="24"
                                           Height="24"
                                           Source="ms-appx:///Assets/Image/Common/star.png" />
                                    <TextBlock x:Name="TextBlock_TotalStar" FontSize="24" FontWeight="Bold" Text="0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Width="24"
                                           Height="24"
                                           Source="ms-appx:///Assets/Image/Common/coin.png" />
                                    <TextBlock x:Name="TextBlock_TotalCoin" FontSize="24" FontWeight="Bold" Text="0" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.Instance.ResourceBrief_StarComposition, Mode=OneWay}" />
                            <Border x:Name="Border_StarBarHost" Height="18" CornerRadius="9"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <StackPanel x:Name="StackPanel_StarBar" Orientation="Horizontal" />
                            </Border>
                            <StackPanel x:Name="StackPanel_StarLegend" Orientation="Horizontal" Spacing="12" />

                            <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.Instance.ResourceBrief_CoinComposition, Mode=OneWay}" />
                            <Border Height="18" CornerRadius="9"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <StackPanel x:Name="StackPanel_CoinBar" Orientation="Horizontal" />
                            </Border>
                            <StackPanel x:Name="StackPanel_CoinLegend" Orientation="Horizontal" Spacing="12" />
                        </StackPanel>
                    </Border>

                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="TextBlock_DetailTitle"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Text="{x:Bind lang:Lang.Instance.ResourceBrief_Detail, Mode=OneWay}" />

                            <ScrollViewer Height="150" VerticalScrollBarVisibility="Visible">
                                <StackPanel x:Name="StackPanel_Items" Spacing="4" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

</mf:PageBase>

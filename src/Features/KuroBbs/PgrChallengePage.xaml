<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.KuroBbs.PgrChallengePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="6" Margin="0,4,0,6">
            <Button x:Name="Button_Refresh"
                    Click="Button_Refresh_Click"
                    Style="{StaticResource KuroBbsEdgeButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Instance.RolePage_Refresh, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="StackPanel_Content" Spacing="12">
                <ProgressRing x:Name="ProgressRing_Loading"
                              IsActive="False"
                              Visibility="Collapsed" />
                <InfoBar x:Name="InfoBar_Error"
                         IsOpen="False"
                         Visibility="Collapsed"
                         Severity="Error" />
                <InfoBar x:Name="InfoBar_NoAccount"
                         IsOpen="False"
                         Visibility="Collapsed"
                         Severity="Warning"
                         Message="{x:Bind lang:Lang.Instance.PgrData_NoRole, Mode=OneWay}" />

                <StackPanel x:Name="StackPanel_Body" Spacing="12" />
            </StackPanel>
        </ScrollViewer>
    </Grid>

</mf:PageBase>

<?xml version="1.0" encoding="utf-8" ?>
<mf:WindowEx x:Class="Arietta.Features.Setting.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mf="using:Arietta.Frameworks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Panel_Left"
              Grid.Row="0"
              Grid.Column="0"
              Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Spacing="8">
                <TextBlock x:Name="TextBlock_Title"
                           FontSize="24" />
                <StackPanel Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <TextBlock x:Name="TextBlock_OldVersion"
                               VerticalAlignment="Bottom"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <FontIcon VerticalAlignment="Bottom"
                              FontSize="16"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Glyph="&#xEBE7;" />
                    <TextBlock x:Name="TextBlock_NewVersion"
                               VerticalAlignment="Bottom"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>

            <Grid x:Name="Grid_Info"
                  Grid.Row="1"
                  Margin="0,14,0,0"
                  ColumnSpacing="12"
                  RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           x:Name="TextBlock_ArchLabel" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           x:Name="TextBlock_Arch" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           x:Name="TextBlock_ChannelLabel" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           x:Name="TextBlock_Channel" />
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           x:Name="TextBlock_BuildLabel" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           x:Name="TextBlock_Build" />
            </Grid>

            <StackPanel Grid.Row="2"
                        Margin="0,12,0,0"
                        Spacing="4">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           x:Name="TextBlock_LinksLabel" />
                <HyperlinkButton Click="HyperlinkButton_Release_Click"
                                 Content=""
                                 Padding="0"
                                 x:Name="HyperlinkButton_Release" />
            </StackPanel>

            <Border Grid.Row="3"
                    Height="1"
                    Margin="0,12,0,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel x:Name="Panel_Options"
                        Grid.Row="4"
                        Margin="0,10,0,0"
                        Spacing="2"
                        VerticalAlignment="Top">
                <CheckBox x:Name="CheckBox_ShowNotes"
                          Click="OnOptionChanged" />
            </StackPanel>

            <StackPanel Grid.Row="5"
                        Spacing="4"
                        Visibility="Collapsed"
                        x:Name="Panel_Progress">
                <Grid>
                    <TextBlock HorizontalAlignment="Left"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               x:Name="TextBlock_Bytes" />
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               x:Name="TextBlock_Percent" />
                </Grid>
                <ProgressBar Maximum="100"
                             x:Name="ProgressBar_Download" />
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           x:Name="TextBlock_ProgressMessage" />
            </StackPanel>

            <StackPanel x:Name="Panel_Actions"
                        Grid.Row="6"
                        Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="24">

                <Button Height="36"
                        Padding="20,0,20,0"
                        BorderThickness="0"
                        CornerRadius="18"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnUpdateNowClick"
                        x:Name="Button_UpdateNow" />

                <Grid>
                    <SplitButton Height="36"
                                 BorderThickness="0"
                                 CornerRadius="18"
                                 Opacity="0"
                                 Click="OnRemindLaterClick"
                                 PointerEntered="SplitButton_RemindLater_PointerEntered"
                                 PointerExited="SplitButton_RemindLater_PointerExited"
                                 x:Name="SplitButton_RemindLater">
                        <TextBlock Margin="4,0,0,0"
                                   Foreground="Transparent"
                                   Text="{x:Bind RemindLaterText}" />
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem Click="OnIgnoreVersionClick"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                x:Name="MenuFlyoutItem_Ignore" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <TextBlock Margin="16,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               IsHitTestVisible="False"
                               Text="{x:Bind RemindLaterText}" />
                </Grid>

            </StackPanel>

        </Grid>

        <Grid x:Name="Panel_Notes"
              Grid.Row="0"
              Grid.Column="1"
              Margin="0,32,0,0">

            <WebView2 x:Name="NotesWeb"
                      UseSystemFocusVisuals="False"
                      DefaultBackgroundColor="Transparent">
                <WebView2.Resources>
                    <SolidColorBrush x:Key="BrushForThemeBackgroundColor" Color="Transparent" />
                </WebView2.Resources>
            </WebView2>

            <StackPanel x:Name="Panel_Checking"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14"
                        Visibility="Collapsed">
                <ProgressRing Width="36"
                              Height="36"
                              IsActive="True" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind CheckingText}" />
            </StackPanel>

            <ScrollViewer x:Name="Scroll_Notes"
                          Padding="24,4,24,12"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel>
                    <ItemsControl x:Name="Images_Notes" />
                    <RichTextBlock x:Name="Rich_Notes"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</mf:WindowEx>

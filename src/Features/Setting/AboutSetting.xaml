<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.Setting.AboutSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             xmlns:lang="using:Arietta.Localization"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock FontSize="24"
                       FontWeight="Bold"
                       Text="Arietta" />

            
            <TextBlock Margin="0,4,0,0"
                       Text="{x:Bind lang:Lang.Instance.SettingPage_About_Copyright}" />

            
            <StackPanel Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.Instance.SettingPage_CurrentVersion}" />
                <TextBlock FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           Text="{x:Bind AppVersionText}" />
            </StackPanel>

            
            <TextBlock Margin="0,20,0,0"
                       FontSize="20"
                       Text="{x:Bind lang:Lang.Instance.SettingPage_About_Links}" />

            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/Pizazz-stack/Arietta" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.Instance.SettingPage_ProjectHomepage}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/Pizazz-stack/Arietta/issues" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.Instance.SettingPage_ReportIssue}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/Pizazz-stack/Arietta/releases" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.Instance.SettingPage_ReleaseHistory}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/Pizazz-stack/Arietta/blob/main/README.md" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.Instance.SettingPage_DataAndPrivacy}" />
                </Hyperlink>
            </TextBlock>

        </StackPanel>
    </ScrollViewer>

</mf:PageBase>

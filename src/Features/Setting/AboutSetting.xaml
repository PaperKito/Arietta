<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.Setting.AboutSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             xmlns:lang="using:Arietta.Localization"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock FontSize="24"
                       FontWeight="Bold"
                       Text="Arietta" />

            <TextBlock Margin="0,4,0,0"
                       Text="{x:Bind lang:Lang.Instance.SettingPage_About_Copyright}" />

            <StackPanel Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.Instance.SettingPage_CurrentVersion}" />
                <TextBlock FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           Text="{x:Bind AppVersionText}" />
            </StackPanel>

            <Grid Margin="0,4,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Height="40"
                        Padding="12,0,16,0"
                        HorizontalAlignment="Left"
                        BorderThickness="0"
                        CornerRadius="4,20,20,4"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnCheckUpdateClick"
                        IsEnabled="{x:Bind CanCheckNow}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE752;" />
                        <TextBlock Text="{x:Bind lang:Lang.Instance.SettingPage_CheckUpdate}" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ProgressRing Width="20"
                                  Height="20"
                                  Visibility="{x:Bind CheckingVisibility}" />
                    <TextBlock MaxWidth="420"
                               HorizontalAlignment="Left"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind StatusText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,8,0,0"
                        Spacing="8"
                        HorizontalAlignment="Left">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           Text="{x:Bind NewVersionText}"
                           Visibility="{x:Bind AvailableVisibility}" />
                <ScrollViewer MaxHeight="160"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind AvailableVisibility}">
                    <TextBlock IsTextSelectionEnabled="True"
                               Text="{x:Bind ReleaseNotesText}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
                <ProgressBar Width="260"
                             Maximum="100"
                             Value="{x:Bind DownloadProgress}"
                             Visibility="{x:Bind DownloadingVisibility}" />
                <Button Click="OnDownloadClick"
                        Content="{x:Bind lang:Lang.Instance.SettingPage_UpdateDownload}"
                        IsEnabled="{x:Bind CanDownloadNow}"
                        Visibility="{x:Bind AvailableVisibility}" />
            </StackPanel>

            <TextBlock Margin="0,20,0,0"
                       FontSize="20"
                       Text="{x:Bind lang:Lang.Instance.SettingPage_About_Links}" />

            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/PaperKito/Arietta" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.Instance.SettingPage_ProjectHomepage}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/PaperKito/Arietta/issues" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.Instance.SettingPage_ReportIssue}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/PaperKito/Arietta/releases" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.Instance.SettingPage_ReleaseHistory}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://paperkitoblog.edgeone.dev/sponsor/" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.Instance.SettingPage_Donate}" />
                </Hyperlink>
            </TextBlock>

        </StackPanel>
    </ScrollViewer>

</mf:PageBase>

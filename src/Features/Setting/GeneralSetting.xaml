<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.Setting.GeneralSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             xmlns:lang="using:Arietta.Localization"
             mc:Ignorable="d">

    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4" MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock Margin="0,0,0,12"
                       FontSize="20"
                       FontWeight="Bold"
                       Text="{x:Bind lang:Lang.Instance.SettingPage_Language, Mode=OneWay}" />

        <ComboBox x:Name="ComboBox_Language"
                  Height="36"
                  MinWidth="260"
                  Margin="0,0,0,0"
                  Padding="18.5,0,0,0"
                  BorderThickness="0"
                  CornerRadius="8,18,18,8"
                  HorizontalAlignment="Left"
                  SelectionChanged="ComboBox_Language_SelectionChanged">

            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_Chinese, Mode=OneWay}" />
            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_HantChinese, Mode=OneWay}" />
            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_English, Mode=OneWay}" />
            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_Japanese, Mode=OneWay}" />
            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_Korean, Mode=OneWay}" />
            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_French, Mode=OneWay}" />
            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_German, Mode=OneWay}" />
            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_Spanish, Mode=OneWay}" />
            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_Thai, Mode=OneWay}" />
            <ComboBoxItem Content="{x:Bind lang:Lang.Instance.Language_PortugueseBrazil, Mode=OneWay}" />
        </ComboBox>

        <TextBlock Margin="0,16,0,12"
                   FontSize="20"
                   FontWeight="Bold"
                   Text="{x:Bind lang:Lang.Instance.SettingPage_WindowBehavior, Mode=OneWay}" />

        <TextBlock Margin="0,0,0,4"
                   FontSize="20"
                   FontWeight="Bold"
                   Text="{x:Bind lang:Lang.Instance.SettingPage_CloseWindowOption, Mode=OneWay}" />

        <StackPanel Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Spacing="24">
            <RadioButton x:Name="Radio_CloseToTray"
                         Checked="Radio_CloseOption_Checked"
                         Content="{x:Bind lang:Lang.Instance.ExperienceSettingPage_MinimizeToSystemTray, Mode=OneWay}"
                         GroupName="CloseWindowOption" />
            <RadioButton x:Name="Radio_ExitApp"
                         Checked="Radio_CloseOption_Checked"
                         Content="{x:Bind lang:Lang.Instance.SettingPage_ExitApp, Mode=OneWay}"
                         GroupName="CloseWindowOption" />
        </StackPanel>

        <TextBlock Margin="0,16,0,4"
                   FontSize="20"
                   FontWeight="Bold"
                   Text="{x:Bind lang:Lang.Instance.SettingPage_AfterLaunchOption, Mode=OneWay}" />

        <StackPanel Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Spacing="24">
            <RadioButton x:Name="Radio_LaunchKeepWindow"
                         Checked="Radio_LaunchOption_Checked"
                         Content="{x:Bind lang:Lang.Instance.SettingPage_KeepWindow, Mode=OneWay}"
                         GroupName="AfterLaunchOption" />
            <RadioButton x:Name="Radio_LaunchToTray"
                         Checked="Radio_LaunchOption_Checked"
                         Content="{x:Bind lang:Lang.Instance.ExperienceSettingPage_MinimizeToSystemTray, Mode=OneWay}"
                         GroupName="AfterLaunchOption" />
        </StackPanel>

        <TextBlock Margin="0,16,0,4"
                   FontSize="20"
                   FontWeight="Bold"
                   Text="{x:Bind lang:Lang.Instance.SettingPage_AfterGameExitOption, Mode=OneWay}" />

        <StackPanel Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Spacing="24">
            <RadioButton x:Name="Radio_ExitRestoreWindow"
                         Checked="Radio_ExitOption_Checked"
                         Content="{x:Bind lang:Lang.Instance.SettingPage_RestoreMainWindow, Mode=OneWay}"
                         GroupName="AfterGameExitOption" />
            <RadioButton x:Name="Radio_ExitKeepHidden"
                         Checked="Radio_ExitOption_Checked"
                         Content="{x:Bind lang:Lang.Instance.SettingPage_KeepHidden, Mode=OneWay}"
                         GroupName="AfterGameExitOption" />
            <RadioButton x:Name="Radio_ExitCloseLauncher"
                         Checked="Radio_ExitOption_Checked"
                         Content="{x:Bind lang:Lang.Instance.SettingPage_CloseLauncher, Mode=OneWay}"
                         GroupName="AfterGameExitOption" />
        </StackPanel>

        <MenuFlyoutSeparator Margin="0,20,0,0" />

        <TextBlock Margin="0,20,0,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   IsTextScaleFactorEnabled="False"
                   Text="{x:Bind lang:Lang.Instance.SettingPage_SuggestSystemFeatures, Mode=OneWay}"
                   TextWrapping="Wrap" />

        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="16">
            <TextBlock IsTextScaleFactorEnabled="False">
                <Hyperlink Click="Hyperlink_VisualEffects_Click" UnderlineStyle="None">
                    <Run Text="{x:Bind lang:Lang.Instance.SettingPage_TransparencyEffects, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock IsTextScaleFactorEnabled="False">
                <Hyperlink Click="Hyperlink_VisualEffects_Click" UnderlineStyle="None">
                    <Run Text="{x:Bind lang:Lang.Instance.SettingPage_AnimationEffects, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        </StackPanel>
    </ScrollViewer>

</mf:PageBase>

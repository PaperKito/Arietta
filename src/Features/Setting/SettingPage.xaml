<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.Setting.SettingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid>

        <NavigationView IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        ItemInvoked="NavigationView_ItemInvoked"
                        OpenPaneLength="260"
                        PaneDisplayMode="Left">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewHeaderMargin">0</Thickness>
                <x:Double x:Key="PaneToggleButtonHeight">0</x:Double>
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <TextBlock Margin="16,12,0,8"
                           FontSize="20"
                           FontWeight="Bold"
                           Text="{x:Bind lang:Lang.Instance.SettingPage_AppSettings, Mode=OneWay}" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind lang:Lang.Instance.SettingPage_About, Mode=OneWay}"
                                    IsSelected="True"
                                    Tag="AboutSetting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind lang:Lang.Instance.SettingPage_General, Mode=OneWay}" Tag="GeneralSetting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{x:Bind lang:Lang.Instance.SettingPage_Download, Mode=OneWay}" Tag="DownloadSetting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEBD3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind lang:Lang.Instance.SettingPage_FileManagement, Mode=OneWay}" Tag="FileManagementSetting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{x:Bind lang:Lang.Instance.SettingPage_Gamepad, Mode=OneWay}" Tag="GamepadSetting">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource XboxFluent2}" Glyph="&#xE9CD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Content="{x:Bind lang:Lang.Instance.Toolbox, Mode=OneWay}" Tag="ToolboxSetting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame Name="Frame_Setting" Margin="24,24,0,0" />

        </NavigationView>

    </Grid>

</mf:PageBase>

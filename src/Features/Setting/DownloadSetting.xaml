<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.Setting.DownloadSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             mc:Ignorable="d">

    <mf:PageBase.Resources>
        <Style TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="20"
                                 Height="20"
                                 Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mf:PageBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel Spacing="28" MaxWidth="1000" HorizontalAlignment="Left" Padding="0,0,0,24">

            <StackPanel Spacing="8">
                <TextBlock FontSize="18"
                           FontWeight="Bold"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind lang:Lang.Instance.FilePage_HardLink, Mode=OneWay}" />
                <TextBlock MaxWidth="680"
                           HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind lang:Lang.Instance.FilePage_HardLinkDesc, Mode=OneWay}"
                           TextWrapping="Wrap" />
                <ToggleSwitch x:Name="Toggle_HardLink"
                              Margin="0,4,0,-6"
                              OffContent="{x:Bind lang:Lang.Instance.FilePage_Disabled, Mode=OneWay}"
                              OnContent="{x:Bind lang:Lang.Instance.FilePage_Enabled, Mode=OneWay}"
                              Toggled="Toggle_HardLink_Toggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock FontSize="18"
                           FontWeight="Bold"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind lang:Lang.Instance.FilePage_SpeedLimit, Mode=OneWay}" />
                <TextBlock MaxWidth="680"
                           HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind lang:Lang.Instance.FilePage_SpeedLimitDesc, Mode=OneWay}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            Margin="0,4,0,-6">
                    <NumberBox x:Name="Box_SpeedLimit"
                               Width="110"
                               MinWidth="0"
                               Minimum="0"
                               Maximum="124"
                               SpinButtonPlacementMode="Hidden"
                               ValueChanged="Box_SpeedLimit_ValueChanged" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               IsTextScaleFactorEnabled="False"
                               Text="MB/s（＜125）" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock FontSize="18"
                           FontWeight="Bold"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind lang:Lang.Instance.FilePage_DownloadThreads, Mode=OneWay}" />
                <TextBlock MaxWidth="680"
                           HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind lang:Lang.Instance.FilePage_DownloadThreadsDesc, Mode=OneWay}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            Spacing="16"
                            Margin="0,4,0,0">
                    <RadioButton x:Name="Radio_ThreadsAuto"
                                 Checked="Radio_Threads_ModeChanged"
                                 Content="{x:Bind lang:Lang.Instance.FilePage_DownloadThreadsAuto, Mode=OneWay}" />
                    <RadioButton x:Name="Radio_ThreadsManual"
                                 Checked="Radio_Threads_ModeChanged"
                                 Content="{x:Bind lang:Lang.Instance.FilePage_DownloadThreadsManual, Mode=OneWay}" />
                </StackPanel>

                <StackPanel x:Name="Panel_ThreadsRow"
                            Orientation="Horizontal"
                            Spacing="12"
                            Margin="0,4,0,-6">
                    <Grid Width="300"
                          VerticalAlignment="Center">
                        <Border Height="6"
                                Margin="14,0"
                                VerticalAlignment="Center"
                                CornerRadius="3"
                                Background="{ThemeResource SliderTrackFill}" />
                        <Slider x:Name="Slider_Threads"
                                Width="300"
                                VerticalAlignment="Center"
                                Maximum="16"
                                Minimum="1"
                                StepFrequency="1"
                                ValueChanged="Slider_Threads_ValueChanged">
                            <Slider.Resources>
                                <Thickness x:Key="SliderBorderThemeThickness">0</Thickness>
                                <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
                                <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
                                <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent" />
                            </Slider.Resources>
                        </Slider>
                    </Grid>
                    <TextBlock x:Name="Text_ThreadsMax"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               IsTextScaleFactorEnabled="False"
                               Text="16" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</mf:PageBase>

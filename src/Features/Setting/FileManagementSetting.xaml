<?xml version="1.0" encoding="utf-8" ?>
<mf:PageBase x:Class="Arietta.Features.Setting.FileManagementSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Arietta.Localization"
             xmlns:local="using:Arietta.Features.Sync"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mf="using:Arietta.Frameworks"
             mc:Ignorable="d">

    <Page.Resources>
        
        <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0,16,0" />
            <Setter Property="CornerRadius" Value="8,20,20,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="PillGlyphStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel Spacing="28" MaxWidth="1000" HorizontalAlignment="Left" Padding="0,0,0,24">

            <StackPanel Spacing="8">
                <TextBlock FontSize="18" FontWeight="Bold" Text="{x:Bind lang:Lang.Instance.FilePage_DataFolder, Mode=OneWay}" />
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           TextWrapping="Wrap"
                           Text="{x:Bind lang:Lang.Instance.FilePage_DataFolderDesc, Mode=OneWay}" />

                
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                    <Button Click="Button_ReselectDataFolder_Click" Style="{StaticResource PillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8DE;" Style="{StaticResource PillGlyphStyle}" />
                            <TextBlock Text="{x:Bind lang:Lang.Instance.FilePage_ReselectDataFolder, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    
                    <Button Height="40"
                            VerticalAlignment="Center"
                            Click="Button_OpenDataFolder_Click"
                            BorderThickness="0"
                            CornerRadius="20"
                            Padding="20,0,20,1">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="{x:Bind lang:Lang.Instance.FilePage_OpenDataFolder, Mode=OneWay}" />
                        </ToolTipService.ToolTip>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="TextBlock_DataPath"
                                       MaxWidth="360"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <FontIcon Margin="0,2,2,0"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE8A7;" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Margin="0,4,0,0"
                        Click="Button_DeleteSettings_Click"
                        Style="{StaticResource PillButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" Style="{StaticResource PillGlyphStyle}" />
                        <TextBlock Text="{x:Bind lang:Lang.Instance.FilePage_DeleteAllSettings, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock FontSize="18" FontWeight="Bold" Text="{x:Bind lang:Lang.Instance.FilePage_CacheLog, Mode=OneWay}" />
                <Button Click="Button_OpenLogFolder_Click" Style="{StaticResource PillButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" Style="{StaticResource PillGlyphStyle}" />
                        <TextBlock Text="{x:Bind lang:Lang.Instance.FilePage_OpenLogFolder, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock FontSize="18" FontWeight="Bold" Text="{x:Bind lang:Lang.Instance.FilePage_Cache, Mode=OneWay}" />

                <Grid HorizontalAlignment="Left" ColumnSpacing="24" RowSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextScaleFactorEnabled="False"
                               Text="{x:Bind lang:Lang.Instance.FilePage_CacheLog, Mode=OneWay}" />
                    <TextBlock x:Name="TextBlock_CacheLogSize"
                               Grid.Row="0"
                               Grid.Column="1"
                               IsTextScaleFactorEnabled="False" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextScaleFactorEnabled="False"
                               Text="{x:Bind lang:Lang.Instance.FilePage_CacheImage, Mode=OneWay}" />
                    <TextBlock x:Name="TextBlock_CacheImageSize"
                               Grid.Row="1"
                               Grid.Column="1"
                               IsTextScaleFactorEnabled="False" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextScaleFactorEnabled="False"
                               Text="{x:Bind lang:Lang.Instance.FilePage_CacheBackground, Mode=OneWay}" />
                    <TextBlock x:Name="TextBlock_CacheBackgroundSize"
                               Grid.Row="2"
                               Grid.Column="1"
                               IsTextScaleFactorEnabled="False" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="Button_CleanCache_Click" Style="{StaticResource PillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA99;" Style="{StaticResource PillGlyphStyle}" />
                            <TextBlock Text="{x:Bind lang:Lang.Instance.FilePage_CleanCache, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="CheckBox_CleanBackground"
                              VerticalAlignment="Center"
                              Content="{x:Bind lang:Lang.Instance.FilePage_CleanBackgroundCache, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <local:CloudSyncSection Margin="0,16,0,0" />

        </StackPanel>
    </ScrollViewer>

</mf:PageBase>
